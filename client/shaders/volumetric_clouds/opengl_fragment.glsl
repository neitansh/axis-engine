/*
 * Объёмные облака.
 *
 * Облако здесь - не тело, а слой конечной толщины на заданной высоте. Луч
 * взгляда не идёт от камеры до неба: считается, где он входит в слой и где
 * выходит, и шаги делаются только на этом отрезке. Не пересёк слой - работы
 * ноль.
 *
 * Форму задаёт двумерный шум вместе с порогом, который растёт к краям слоя по
 * высоте: у середины облаку хватает и слабого шума, у кромки нужен сильный.
 * Выходит линза - толстая в середине, сходящая на нет к краям, - и всё это по
 * одной выборке шума вместо трёхмерного.
 *
 * Трассировка обрывается на первом попадании: облака непрозрачны, копить
 * поглощение вдоль луча незачем. Прозрачными их делает не плотность, а даль -
 * у горизонта они растворяются в небе.
 */

#define rendered texture0
#define depthmap texture1

uniform sampler2D rendered;
uniform sampler2D depthmap;

uniform vec3 cameraPosition;
uniform vec3 cameraOffset;
uniform mat4 mInvViewProj;
uniform float animationTimer;
// Секунды с начала игры. animationTimer для облаков не годится: он
// сбрасывается каждые несколько минут, и слой дёргался бы на месте.
uniform float cloudTime;

uniform vec3 dayLight;
uniform vec4 fogColor;
uniform float fogDistance;
uniform vec3 sunDirection;

// x - высота слоя в узлах, y - плотность (0..1), z - скорость ветра,
// w - дальность, за которой облака растворяются, в узлах
uniform vec4 cloudParams;
// x - размер облака в узлах, y - толщина слоя в узлах, z - блочность (0..0.5),
// w - сторона квадрата, из которых облако сложено, в узлах
uniform vec4 cloudShape;

CENTROID_ VARYING_ mediump vec2 varTexCoord;

const float NODE_SIZE = 10.0; // BS

// Сколько шагов луч делает, самое большее. Длина шага при этом не зависит от
// длины отрезка: она берётся от размера облака, иначе при пологом взгляде,
// когда отрезок тянется на тысячи узлов, шаг перерастает само облако и луч
// перепрыгивает его целиком - облака выходят рваными.
const int CLOUD_SAMPLES = 44;

float hash12(vec2 p)
{
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

float valueNoise(vec2 p)
{
	vec2 i = floor(p);
	vec2 f = fract(p);
	f = f * f * (3.0 - 2.0 * f);

	float a = hash12(i);
	float b = hash12(i + vec2(1.0, 0.0));
	float c = hash12(i + vec2(0.0, 1.0));
	float d = hash12(i + vec2(1.0, 1.0));

	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Координаты выборки, округлённые до клеток - отсюда кубическая форма.
// Дробная часть протаскивается через ступеньку со сглаженными краями, так что
// облако рвётся не по прямой, а с мягкой кромкой.
vec2 roundedCoord(vec2 pos, float roundness)
{
	if (roundness >= 0.499)
		return pos; // просить нечего, край и так гладкий

	vec2 coord = pos + 0.5;
	vec2 s = sign(coord);
	coord = abs(coord) + 1.0;
	vec2 i = floor(coord);
	vec2 f = coord - i;
	f = smoothstep(0.5 - roundness, 0.5 + roundness, f);
	return (i + f - 0.5) * s;
}

/*
 * Сколько облака в этой точке по горизонтали, 0..1.
 *
 * Две составляющие с разным шагом. Первая, редкая, решает, есть ли здесь облака
 * вообще: без неё небо засевается равномерно и превращается в потолок. Вторая
 * лепит из отмеченного участка отдельные клубы.
 */
float cloudCover(vec2 world_xz)
{
	vec2 w = world_xz;
	w.x -= cloudTime * cloudParams.z; // ветер

	/*
	 * Квадратность и размер облака - разные вещи, и решётки у них разные.
	 *
	 * Сначала точка выборки прижимается к сетке со стороной в один квадрат:
	 * шум читается ступеньками, и края облака выходят кубическими. И только
	 * потом эта прижатая точка переводится в масштаб самого облака, который
	 * во много раз крупнее. Округляй по решётке облака - и вместо квадратов
	 * получатся гладкие кляксы во всё небо.
	 */
	float pixel = max(cloudShape.w, 0.5);
	vec2 q = roundedCoord(w / pixel, cloudShape.z) * pixel;

	vec2 p = q / max(cloudShape.x, 1.0);

	/*
	 * Одна выборка шума на пробу, и только одна.
	 *
	 * Раньше их было две: вторая, покрупнее, размечала, где облака вообще
	 * бывают. Но берут этот покров по три раза на каждую пробу луча, а проб
	 * до полусотни - и лишняя выборка выливалась в треть всей работы кадра.
	 * Разрежает небо порог; на вид разницы не осталось.
	 */
	return valueNoise(p);
}

/*
 * Насколько плотно облако в этой точке слоя, 0..1.
 *
 * Отвечать "да" или "нет" нельзя: на кромке соседние пиксели получали бы разные
 * ответы, и край облака рассыпался бы в отдельные точки. Плавный переход у
 * порога делает кромку мягкой, а заодно позволяет копить плотность вдоль луча.
 */
float cloudDensity(vec3 world_pos, float altitude, float half_thickness)
{
	/*
	 * Насколько высота вообще влияет на то, есть ли здесь облако.
	 *
	 * Влиять она должна еле-еле. Дай ей волю - и низ облака поедет за покровом:
	 * где гуще, там свисает ниже. А покров нарезан по клеткам в десятки узлов,
	 * так что дно пошло бы лесенкой с шагом в целую клетку. Облако-плита должно
	 * иметь ровное дно, поэтому высота лишь чуть подтачивает самые кромки.
	 */
	float t = clamp(abs(altitude - world_pos.y) / half_thickness, 0.0, 1.0);
	t = t * t; t = t * t; t = t * t;

	// Плотность двигает порог: 0 - редкие клочья, 1 - сплошная пелена
	float threshold = mix(0.78, 0.46, cloudParams.y) + t * 0.12;

	/*
	 * Форма смещается с высотой, немного и вкось.
	 *
	 * Без этого по вертикали она не меняется вовсе: облако выходит колонной с
	 * ровными боками, и снизу, у самого зенита, вместо клубов видны вытянутые
	 * полосы - луч идёт вдоль колонны и всю дорогу встречает одно и то же.
	 */
	vec2 slant = vec2(world_pos.y * 0.08, world_pos.y * 0.05);
	float cover = cloudCover(world_pos.xz + slant);

	/*
	 * Переход у порога узкий: либо облако есть, либо его нет. Растяни его - и
	 * рядом с плитами повиснут их бледные подобия, места, где покрова хватило
	 * едва-едва. Мягкость краю даёт не это, а длина пути луча внутри плиты.
	 */
	return smoothstep(threshold, threshold + 0.008, cover);
}

void main(void)
{
	vec2 uv = varTexCoord.st;
	vec3 scene = texture2D(rendered, uv).rgb;
	float raw_depth = texture2D(depthmap, uv).r;

	gl_FragColor = vec4(scene, 1.0);

	/*
	 * Луч взгляда через этот пиксель.
	 *
	 * Обратная матрица возвращает точку в тех же осях, в которых рисуется мир,
	 * а он отсчитывается от смещения камеры. Сама же камера дана абсолютно,
	 * поэтому для разности её нужно перевести в те же оси.
	 */
	vec3 cam_local = cameraPosition - cameraOffset;

	vec4 far_ndc = vec4(uv * 2.0 - 1.0, 1.0, 1.0);
	vec4 far_point = mInvViewProj * far_ndc;
	vec3 view_ray = normalize(far_point.xyz / far_point.w - cam_local);

	// Камера в узлах, абсолютно: облака не должны ехать вместе со смещением
	vec3 cam = cameraPosition / NODE_SIZE;
	float altitude = cloudParams.x;
	float half_thickness = max(cloudShape.y, 1.0) * 0.5;

	// Насколько далеко видно сквозь пиксель: за геометрией облаков не бывает
	float scene_distance = 1.0e9;
	if (raw_depth < 1.0) {
		vec4 scene_ndc = vec4(uv * 2.0 - 1.0, raw_depth * 2.0 - 1.0, 1.0);
		vec4 scene_point = mInvViewProj * scene_ndc;
		scene_distance = distance(scene_point.xyz / scene_point.w, cam_local)
				/ NODE_SIZE;
	}

	// Где луч пересекает границы слоя
	float lower = altitude - half_thickness;
	float upper = altitude + half_thickness;

	// Совсем горизонтальный луч слой не пересечёт никогда. Порог здесь должен
	// быть крошечным: при большем по небу шла бы чистая полоса ровно на высоте
	// взгляда - там, где облака как раз и ждёшь.
	if (abs(view_ray.y) < 1.0e-6)
		return;

	float d_lower = (lower - cam.y) / view_ray.y;
	float d_upper = (upper - cam.y) / view_ray.y;
	float d_near = max(min(d_lower, d_upper), 0.0);
	float d_far = max(d_lower, d_upper);

	if (d_far <= 0.0)
		return; // слой позади
	d_far = min(d_far, cloudParams.w);
	if (d_near >= d_far)
		return;

	/*
	 * Шаг подбирается так, чтобы луч сделал десяток с лишним проб на пути
	 * сквозь слой - при любом наклоне. Смотришь вверх - путь короткий и шаг
	 * мелкий; смотришь вдоль - путь долгий, и шаг растёт, иначе проб не
	 * напасёшься. Но крупнее половины облака он не станет: иначе клуб
	 * проскакивает между двумя пробами.
	 */
	float slab_length = min(d_far, d_near + 8.0 * max(cloudShape.y, 1.0)) - d_near;
	/*
	 * Верхний предел шага важен не только для вида, но и для цены: у горизонта
	 * луч идёт вдоль слоя тысячи узлов, и мелким шагом он выберет весь запас
	 * проб, ничего не встретив. Вблизи же, где взгляд поперёк слоя, предел и не
	 * достигается - там шаг задаёт первое слагаемое.
	 */
	float step_size = clamp(slab_length / 32.0, 0.75,
			max(2.0, cloudShape.x * 0.3));

	/*
	 * Начало сдвигается, иначе ступеньки трассировки ложатся на небо ровными
	 * дугами. Сдвиг взят упорядоченным, а не случайным: случайный на каждый
	 * пиксель - это и есть песок, который так хорошо видно на ровной белизне.
	 */
	float dither = fract(dot(gl_FragCoord.xy, vec2(0.7548777, 0.5698403)));

	// Сдвиг мелкий: на боковой грани плиты соседние пиксели иначе проходят
	// внутри неё разный путь, набирают разную непрозрачность - и ровная грань
	// рассыпается на точки.
	float travelled = d_near + step_size * dither * 0.6;
	float coverage = 0.0;
	vec3 color = vec3(0.0);
	float hit_distance = 0.0;

	for (int i = 0; i < CLOUD_SAMPLES; i++) {
		if (travelled > d_far || travelled > scene_distance)
			break;

		vec3 pos = cam + view_ray * travelled;
		float density = cloudDensity(pos, altitude, half_thickness);

		if (density > 0.5) {
			if (coverage <= 0.0) {
				/*
				 * Свет считается один раз, по первой встреченной точке: дальше
				 * луч идёт внутри того же облака, и цвет там тот же самый.
				 *
				 * Две выборки покрова в сторону солнца - грубая, но убедительная
				 * самозатенённость: если по пути к солнцу облако плотное, эта
				 * точка в тени собственного клуба. Плюс градиент по высоте.
				 */
				float cloud_size = max(cloudShape.x, 1.0);
				vec2 to_sun = normalize(sunDirection.xz + vec2(0.001)) * cloud_size;

				// Одна проба в сторону солнца: вторая давала прибавку, которую
				// на глаз не поймать, а стоила ровно столько же
				float lit = clamp(1.35 - cloudCover(pos.xz + to_sun * 0.55) * 1.35,
						0.0, 1.0);

				float height_shade = clamp((pos.y - lower) / (upper - lower),
						0.0, 1.0);
				lit = lit * (0.46 + 0.54 * height_shade);

				// Низ облака - холодная тень неба, верх - солнце. Снизу видно
				// как раз дно, поэтому тень должна быть заметной, иначе облако
				// выходит белым пятном без всякого объёма.
				// Дно облака не тёмное: свет и снизу приходит - от неба и от
				// земли, - поэтому тень здесь лишь оттеняет форму, а не красит
				// облако в серый.
				vec3 shaded = fogColor.rgb * 0.66;
				vec3 sunlit = dayLight * 1.25;
				color = mix(shaded, sunlit, smoothstep(0.05, 0.88, lit));

				hit_distance = travelled;
			}

			/*
			 * Копится по пройденному пути, и только по нему.
			 *
			 * Не по числу проб - иначе всё зависело бы от длины шага, а она у
			 * соседних пикселей разная, и ровно белое облако пошло бы рябью.
			 * И не от того, насколько покров превысил порог: облако, которому
			 * покрова хватило едва-едва, повисло бы рядом с плитами бледным
			 * подобием. Плита есть плита; прозрачной её край делает лишь то,
			 * что луч проходит по нему вскользь.
			 */
			coverage += step_size / max(cloudShape.y * 0.22, 1.0);
			// Дальше набирать нечего: облако и так уже непрозрачно
			if (coverage >= 0.5)
				break;
		}

		travelled += step_size;
		// Дальше можно грубее: там облако и на экране мельче
		step_size = min(step_size * 1.05, max(2.0, cloudShape.x * 0.5));
	}

	if (coverage <= 0.0)
		return;

	/*
	 * Даль. Облака уходят в тот же туман, что и мир, иначе над затянутым
	 * дымкой горизонтом висит неправдоподобно чёткая гряда.
	 */
	float fade = clamp(hit_distance / cloudParams.w, 0.0, 1.0);
	color = mix(color, fogColor.rgb, fade * fade * 0.9);

	/*
	 * Кромка на просвет. Смотришь в сторону солнца - и край облака, сквозь
	 * который свет проходит почти насквозь, вспыхивает. Отсюда та самая
	 * серебряная оторочка, без которой облако выглядит вырезанным из бумаги.
	 */
	float sun_align = max(dot(view_ray, normalize(sunDirection)), 0.0);
	float rim = pow(sun_align, 8.0) * (1.0 - clamp(coverage, 0.0, 1.0));
	color += dayLight * rim * 0.8;

	/*
	 * Облако либо есть, либо его нет.
	 *
	 * Плотность набирается по пути внутри плиты, но в непрозрачность она
	 * переходит круто: стоит лучу пройти хоть немного - и облако сплошное, как
	 * соседнее. Иначе одна плита выходит гуще другой без всякой причины, и небо
	 * пестрит разной плотностью там, где облака одинаковы. Полупрозрачным
	 * остаётся лишь самый край, где луч едва задел плиту.
	 */
	float alpha = smoothstep(0.06, 0.3, coverage) * (1.0 - fade * fade);
	// И тают перед геометрией, чтобы не врезаться в неё кромкой
	alpha *= clamp((scene_distance - hit_distance) * 0.05, 0.0, 1.0);

	gl_FragColor = vec4(mix(scene, color, clamp(alpha, 0.0, 1.0)), 1.0);
}
