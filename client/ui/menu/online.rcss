/*
 * Сетевая игра: переключатель «Матчи / Серверы» под шапкой, ниже — либо
 * арены плитками с карточкой подключения слева, либо список серверов в
 * карточке с выбранным справа. Страница, шапка и заголовки — в page.rcss.
 */

/* Переключатель: дорожка цвета карточки, выбранная вкладка поднимается
   подсветкой акцента, а не заливается им — фиолетовый здесь значит «сюда
   нажимать» */

.switch-bar {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-bottom: 28dp;
}

.switch {
	position: relative;
	display: flex;
	flex-direction: row;
	padding: 4dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
}

.switch .indicator {
	position: absolute;
	top: 4dp;
	left: 4dp;
	width: 160dp;
	height: 36dp;
	border-radius: 9dp;
	background-color: #2C2C2E;
	transition: transform 0.25s cubic-out;
}

.switch .option {
	position: relative;
	width: 160dp;
	height: 36dp;
	line-height: 36dp;
	text-align: center;
	font-size: 14dp;
	color: #A1A1A6;
	cursor: pointer;
	transition: color 0.12s linear-in-out;
}

.switch .option:hover,
.switch .option.active {
	color: #F5F5F7;
}

.online-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

.aside {
	display: flex;
	flex-direction: column;
	width: 280dp;
	margin-right: 28dp;
}

.aside .eyebrow {
	padding-left: 2dp;
}

.main {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
}

/* Подключение: карточка с точкой состояния */

.connection {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 14dp 16dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
}

.connection .dot {
	width: 10dp;
	height: 10dp;
	margin-right: 12dp;
	border-radius: 5dp;
	background-color: #86868B;
}

.connection.named .dot {
	background-color: #30D158;
}

.connection.checking .dot {
	background-color: #FF9F0A;
}

.connection.none .dot {
	background-color: #FF453A;
}

.connection .text {
	display: block;
	flex: 1;
	font-size: 14dp;
	color: #F5F5F7;
}

.aside p.note {
	margin-top: 12dp;
	padding: 0 2dp;
	font-size: 13dp;
	line-height: 1.55;
	color: #86868B;
}

/* Арены: карточки на странице */

.arenas {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
}

.centered {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	flex: 1;
	text-align: center;
}

.centered p {
	font-size: 14dp;
	color: #A1A1A6;
	margin-bottom: 16dp;
}

.spinner {
	width: 22dp;
	height: 22dp;
	margin-bottom: 14dp;
	border-radius: 11dp;
	border: 3dp #2C2C2E;
	border-top-color: #A78BFA;
	animation: 0.9s linear-in-out infinite spin;
}

.spinner.big {
	width: 40dp;
	height: 40dp;
	border-radius: 20dp;
	margin-bottom: 22dp;
}

@keyframes spin {
	from { transform: rotate(0deg); }
	to { transform: rotate(360deg); }
}

.tiles {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	overflow-y: auto;
	margin: 8dp -6dp 0 -6dp;
}

.tile {
	display: flex;
	flex-direction: column;
	justify-content: center;
	width: 200dp;
	height: 110dp;
	margin: 6dp;
	padding: 0 20dp;
	box-sizing: border-box;
	border-radius: 18dp;
	background-color: #1C1C1E;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out, transform 0.15s cubic-out;
}

.tile:hover {
	background-color: #2C2C2E;
	transform: translateY(-2dp);
}

.tile .tile-title {
	display: block;
	font-size: 18dp;
	font-weight: 600;
	letter-spacing: -0.2dp;
	color: #F5F5F7;
	white-space: nowrap;
	overflow: hidden;
}

.tile .tile-count {
	display: block;
	margin-top: 6dp;
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #A78BFA;
}

.arenas p.status {
	margin-top: 12dp;
	font-size: 14dp;
	color: #FF453A;
}

/* Ожидание */

.waiting {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	flex: 1;
	text-align: center;
}

.queue-title {
	display: block;
	font-size: 30dp;
	font-weight: 700;
	letter-spacing: -0.5dp;
	color: #F5F5F7;
	margin-bottom: 14dp;
}

.queue-line {
	display: block;
	font-size: 16dp;
	color: #F5F5F7;
	margin-bottom: 6dp;
}

.queue-below {
	display: block;
	font-size: 14dp;
	color: #86868B;
	margin-bottom: 28dp;
}

.waiting button {
	padding: 0 28dp;
}

/* Список серверов в карточке */

.servers-card {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
	padding: 0 24dp 16dp 24dp;
	border-radius: 18dp;
	background-color: #1C1C1E;
}

.server-list {
	display: block;
	flex: 1;
	overflow-y: auto;
	margin-top: 6dp;
	padding-right: 8dp;
}

.server-list scrollbarvertical {
	width: 4dp;
	margin: 0;
}

.server-list scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF24;
}

.section {
	display: block;
	margin: 14dp 0 6dp 0;
	font-size: 13dp;
	color: #86868B;
}

.server {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 48dp;
	padding: 0 12dp;
	margin: 0 0 2dp -12dp;
	border-radius: 10dp;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out;
}

.server:hover {
	background-color: #FFFFFF14;
}

.server.active {
	background-color: #221B36;
}

.server .star {
	width: 16dp;
	height: 16dp;
	margin-right: 10dp;
	decorator: image(icons/star.png scale-none);
	image-color: #FF9F0A;
}

.server .name {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
	font-size: 15dp;
	color: #F5F5F7;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.server.active .name {
	color: #A78BFA;
}

.server .players,
.server .ping {
	width: 80dp;
	text-align: right;
	font-family: "Departure Mono";
	font-size: 12dp;
	color: #86868B;
}

.server .players {
	color: #A1A1A6;
}

.server .ping.good { color: #30D158; }
.server .ping.fair { color: #FF9F0A; }
.server .ping.poor { color: #FF453A; }

.server-list .empty {
	padding: 40dp 0;
	text-align: center;
	color: #86868B;
}

.list-actions {
	display: flex;
	flex-direction: row;
	margin-top: 12dp;
	padding-top: 12dp;
	border-top: 1dp #2C2C2E;
}

button.refresh {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 40dp;
	line-height: 38dp;
	padding: 0 18dp;
	font-size: 14dp;
}

button.refresh .icon {
	width: 18dp;
	height: 18dp;
	margin-right: 8dp;
	decorator: image(icons/reset.png scale-none);
}

/* Правая колонка на странице */

.side {
	display: flex;
	flex-direction: column;
	width: 320dp;
	margin-left: 32dp;
	padding-top: 6dp;
}

.side-body {
	display: flex;
	flex-direction: column;
	align-items: stretch;
}

.side-body.direct {
	margin-top: 32dp;
	padding-top: 20dp;
	border-top: 1dp #2C2C2E;
}

.side h4 {
	display: block;
	font-size: 22dp;
	font-weight: 600;
	letter-spacing: -0.3dp;
	color: #F5F5F7;
	margin: 0 0 14dp 0;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.side-body.direct h4 {
	font-size: 13dp;
	font-weight: 400;
	letter-spacing: 0;
	color: #86868B;
	margin-bottom: 8dp;
}

.facts {
	display: flex;
	flex-direction: column;
	margin-bottom: 8dp;
}

.fact {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 10dp 0;
	border-top: 1dp #2C2C2E;
	font-size: 14dp;
}

.fact .k {
	color: #86868B;
}

.fact .v {
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #F5F5F7;
}

.address-row {
	display: flex;
	flex-direction: row;
}

.address-row input.address {
	flex: 1;
	margin-right: 8dp;
}

.address-row input.port {
	width: 84dp;
}

.side button {
	width: 100%;
	margin-top: 8dp;
}

.side button.big {
	margin-top: 20dp;
	font-size: 16dp;
}

.side-body.direct button {
	margin-top: 12dp;
}
