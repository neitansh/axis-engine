<rml>
<head>
	<title>chrome</title>
	<link type="text/rcss" href="theme.rcss"/>
	<style>
		body {
			display: block;
			pointer-events: none;
			z-index: 100;
		}

		body.shown .version {
			animation: 0.7s linear-in-out chrome-in;
		}

		@keyframes chrome-in {
			0% { opacity: 0; }
			100% { opacity: 1; }
		}
	</style>
</head>
<body data-model="chrome">
	<p class="version">{{ version }}</p>
</body>
</rml>
