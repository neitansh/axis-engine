/*
 * Чат в игре: внизу слева, поверх мира. Одна тёмная подложка под всеми
 * строками и такая же под полем ввода — и свёрнутым, и открытым: открытие
 * ничего не перекрашивает, закрытие ничего не сдвигает (место под поле
 * занято всегда, поле лишь прячется). Свёрнутым строка гаснет, потом
 * уходит из подложки, пустая подложка исчезает. Имя автора — Departure
 * Mono, текст — Inter: разные шрифты разводят их лучше цвета. Словарь
 * цветов — theme.rcss.
 */

body.chat {
	display: block;
	background-color: transparent;
	font-size: 15dp;
}

body.chat.hidden {
	visibility: hidden;
}

.panel {
	position: absolute;
	left: 16dp;
	bottom: 64dp;
	width: 42%;
	min-width: 360dp;
	max-width: 640dp;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}

/* Свёрнутый: без прокрутки, строки только последние; открытый — до
   половины экрана, колесо и PgUp/PgDn. Полоса прокрутки короче
   списка на отступ, чтобы не вылезать за пузыри. */

.history {
	display: block;
	width: 100%;
	max-height: 50vh;
	overflow-y: hidden;
	margin-bottom: 6dp;
	padding: 4dp 0;
	border-radius: 6dp;
	background-color: #000000A6;
}

/* Класс не empty: так в теме зовётся пустой список с отступом и текстом по
   центру, и подложка чата от него ехала. */

.history.quiet {
	visibility: hidden;
}

body.open .history {
	overflow-y: auto;
	visibility: visible;
}

.history scrollbarvertical {
	width: 4dp;
	margin: 4dp 0 4dp 4dp;
}

.history scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF3A;
}

.line {
	display: block;
	padding: 2dp 12dp;
	line-height: 1.35;
	opacity: 1;
	transition: opacity 0.8s linear-in-out;
	overflow: hidden;
}

.line.old {
	opacity: 0;
}

.line.gone {
	display: none;
}

body.open .line.old {
	opacity: 1;
	transition: none;
}

body.open .line.gone {
	display: block;
}

.line .name {
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #A78BFA;
	margin-right: 8dp;
}

.line[kind="own"] .name {
	color: #F5F5F7;
}

.line[kind="system"] .text,
.line[kind="command"] .text {
	color: #A1A1A6;
}

.line[kind="announce"] .text {
	color: #FF9F0A;
}

.line .link {
	color: #8888FF;
	text-decoration: underline;
	cursor: pointer;
}

.line .count {
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #86868B;
	margin-left: 6dp;
}

/* Поле ввода — такая же подложка, как у строк; кайма только в фокусе, то
   есть пока чат открыт. Селектор с типом: у темы input.text задан свой
   вид, класс один его не перебьёт. */

input.draft {
	visibility: hidden;
	width: 100%;
	height: 36dp;
	line-height: 22dp;
	padding: 7dp 12dp;
	border-radius: 6dp;
	border: 1dp #00000000;
	background-color: #000000A6;
	font-family: "Departure Mono";
	font-size: 14dp;
	color: #F5F5F7;
}

body.open input.draft {
	visibility: visible;
}

input.draft:hover {
	border-color: #00000000;
}

input.draft:focus {
	border-color: #A78BFA80;
}
