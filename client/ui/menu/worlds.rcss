/*
 * Одиночная игра: слева крейты списком разделов, в середине миры выбранного
 * крейта в карточке, справа — что делать с выбранным миром (играть, удалить)
 * или форма нового. Страница, шапка и заголовки — в page.rcss.
 */

.play-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

/* Крейты: строки бокового списка, выбранная — цвета карточки */

.crates {
	display: flex;
	flex-direction: column;
	width: 280dp;
	margin-right: 28dp;
}

.crates .eyebrow {
	padding-left: 14dp;
}

.crate {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 64dp;
	padding: 0 14dp;
	margin-bottom: 4dp;
	border-radius: 12dp;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out;
}

.crate:hover {
	background-color: #FFFFFF14;
}

.crate.active {
	background-color: #1C1C1E;
}

.crate .icon,
.crate .tile {
	width: 40dp;
	height: 40dp;
	margin-right: 12dp;
	border-radius: 10dp;
}

.crate .tile {
	background-color: #221B36;
	line-height: 40dp;
	text-align: center;
	font-size: 18dp;
	font-weight: 700;
	color: #A78BFA;
}

.crate .text {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.crate .name {
	display: block;
	font-size: 15dp;
	font-weight: 500;
	color: #A1A1A6;
	transition: color 0.12s linear-in-out;
}

.crate:hover .name,
.crate.active .name {
	color: #F5F5F7;
}

.crate .meta {
	display: block;
	font-size: 12dp;
	color: #86868B;
}

.crate .count {
	padding: 1dp 8dp;
	border-radius: 6dp;
	background-color: #2C2C2E;
	font-size: 12dp;
	color: #A1A1A6;
}

.crate.active .count {
	background-color: #221B36;
	color: #A78BFA;
}

/* Миры: карточка со строками */

.worlds {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
	padding: 0 24dp 16dp 24dp;
	border-radius: 18dp;
	background-color: #1C1C1E;
}

.world-list {
	display: block;
	flex: 1;
	overflow-y: auto;
	margin-top: 6dp;
	padding-right: 8dp;
}

.world-list scrollbarvertical {
	width: 4dp;
	margin: 0;
}

.world-list scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF24;
}

.world {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 52dp;
	padding: 0 12dp;
	margin: 0 0 2dp -12dp;
	border-radius: 10dp;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out;
}

.world:hover {
	background-color: #FFFFFF14;
}

.world.active {
	background-color: #221B36;
}

.world .name {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
	font-size: 15dp;
	color: #F5F5F7;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.world.active .name {
	color: #A78BFA;
}

.world .meta {
	margin-left: 12dp;
	font-family: "Departure Mono";
	font-size: 12dp;
	color: #86868B;
}

.worlds .empty {
	padding: 40dp 0;
	text-align: center;
	color: #86868B;
}

.list-actions {
	display: flex;
	flex-direction: row;
	margin-top: 12dp;
	padding-top: 12dp;
	border-top: 1dp #2C2C2E;
}

button.new {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 40dp;
	line-height: 38dp;
	padding: 0 18dp;
	font-size: 14dp;
}

button.new .plus {
	width: 16dp;
	height: 16dp;
	margin-right: 8dp;
	decorator: image(icons/plus.png scale-none);
}

/* Правая колонка на странице */

.side {
	display: flex;
	flex-direction: column;
	width: 320dp;
	margin-left: 32dp;
	padding-top: 6dp;
}

.side-body {
	display: flex;
	flex-direction: column;
	align-items: stretch;
}

.side h4 {
	display: block;
	font-size: 22dp;
	font-weight: 600;
	letter-spacing: -0.3dp;
	color: #F5F5F7;
	margin: 0 0 14dp 0;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.side label {
	display: block;
	margin: 12dp 0 6dp 0;
	font-size: 13dp;
	color: #86868B;
}

.side input.text,
.side select {
	width: 100%;
}

.side p.hint {
	margin-top: 10dp;
	font-size: 13dp;
	line-height: 1.5;
	color: #86868B;
}

.facts {
	display: flex;
	flex-direction: column;
	margin-bottom: 8dp;
}

.fact {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 10dp 0;
	border-top: 1dp #2C2C2E;
	font-size: 14dp;
}

.fact .k {
	color: #86868B;
}

.fact .v {
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #F5F5F7;
}

.side button {
	width: 100%;
	margin-top: 8dp;
}

.side button.big {
	margin-top: 20dp;
	font-size: 16dp;
}

.side .confirm {
	margin-top: 20dp;
}

.side .confirm p {
	margin-bottom: 4dp;
}

/* Крейтов нет */

.no-crates {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	flex: 1;
	text-align: center;
}

.no-crates .mark {
	width: 48dp;
	height: 48dp;
	margin-bottom: 20dp;
	decorator: image(icons/package.png scale-none);
	image-color: #A78BFA;
}

.no-crates h4 {
	display: block;
	width: 560dp;
	font-size: 22dp;
	font-weight: 600;
	color: #F5F5F7;
	margin: 0 0 10dp 0;
}

.no-crates p {
	width: 480dp;
	font-size: 15dp;
	line-height: 1.55;
	color: #A1A1A6;
}
