/*
 * Миры плейса, выбранного карточкой (places.rml): миры в карточке, справа —
 * что делать с выбранным миром (играть, удалить) или форма нового.
 * Страница, шапка и заголовки — в page.rcss.
 */

.play-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

/* Миры: карточка со строками */

.worlds {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
	padding: 0 24dp 16dp 24dp;
	border-radius: 18dp;
	background-color: #1C1C1E;
}

/* Полоса прокрутки уходит в правый отступ карточки: строки кончаются там же,
   где черта заголовка, а не на ширину полосы раньше */

.world-list {
	display: block;
	flex: 1;
	overflow-y: auto;
	margin-top: 6dp;
	margin-right: -12dp;
	padding-right: 12dp;
}

.world-list scrollbarvertical {
	width: 4dp;
	margin: 0;
}

.world-list scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF24;
}

.world {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 52dp;
	padding: 0 12dp;
	margin-bottom: 2dp;
	border-radius: 10dp;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out;
}

.world:hover,
.world:focus {
	background-color: #2E2E30;
}

.world.active {
	background-color: #221B36;
}

.world .name {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
	font-size: 15dp;
	color: #F5F5F7;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.world.active .name {
	color: #A78BFA;
}

.world .meta {
	margin-left: 12dp;
	font-family: "Departure Mono";
	font-size: 12dp;
	color: #86868B;
}

.worlds .empty {
	padding: 40dp 0;
	text-align: center;
	color: #86868B;
}

.list-actions {
	display: flex;
	flex-direction: row;
	margin-top: 12dp;
	padding-top: 12dp;
	border-top: 1dp #2C2C2E;
}

button.new {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	height: 40dp;
	line-height: 38dp;
	padding: 0 18dp;
	font-size: 14dp;
}

button.new .plus {
	width: 16dp;
	height: 16dp;
	margin-right: 8dp;
	decorator: image(icons/plus.png scale-none);
}

/* Правая колонка на странице */

.side {
	display: flex;
	flex-direction: column;
	width: 320dp;
	margin-left: 28dp;
	padding: 16dp 24dp 24dp 24dp;
}

.side-body {
	display: flex;
	flex-direction: column;
	align-items: stretch;
}

.side h4 {
	display: block;
	font-size: 22dp;
	font-weight: 600;
	letter-spacing: -0.3dp;
	color: #F5F5F7;
	margin: 0 0 14dp 0;
	white-space: nowrap;
	overflow: hidden;
	mask-image: linear-gradient(to right, #FFFFFF 85%, #FFFFFF00 100%);
}

.side label {
	display: block;
	margin: 12dp 0 6dp 0;
	font-size: 13dp;
	color: #86868B;
}

.side input.text,
.side select {
	width: 100%;
}

.side p.hint {
	margin-top: 10dp;
	font-size: 13dp;
	line-height: 1.5;
	color: #86868B;
}

.facts {
	display: flex;
	flex-direction: column;
	margin-bottom: 8dp;
}

.fact {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 10dp 0;
	border-top: 1dp #2C2C2E;
	font-size: 14dp;
}

.fact .k {
	color: #86868B;
}

.fact .v {
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #F5F5F7;
}

.side button {
	width: 100%;
	margin-top: 8dp;
}

.side button.big {
	margin-top: 20dp;
	font-size: 16dp;
}

.side .confirm-actions button {
	width: 0;
	margin-top: 0;
}
