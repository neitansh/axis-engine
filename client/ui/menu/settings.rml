<rml>
<head>
	<title>settings</title>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="page.rcss"/>
	<link type="text/rcss" href="settings.rcss"/>
</head>
<body data-model="settings" class="page settings">
	<div class="page-head">
		<div class="head-side">
			<div class="back" data-event-click="nav('start')"><div class="arrow"/></div>
			<h1>[[Settings]]</h1>
			<span class="kbd">Esc</span>
		</div>
		<div class="tabs">
			<div class="indicator" data-style-transform="tab_indicator"/>
			<div data-for="p : pages" class="tab" data-class-active="p.id == page"
					data-event-click="open(p.id)">
				<img data-attr-src="'icons/' + p.id + '.png'"/>
				<span class="caption" data-if="p.id == page">{{ p.title }}</span>
			</div>
		</div>
		<div class="head-side"/>
	</div>

	<div class="settings-body">
		<div class="rows-frame">
			<div class="rows" id="rows">
				<div data-for="r : rows">
					<h3 class="group" data-if="r.kind == 'heading'">{{ r.label }}</h3>
					<div class="setting" data-if="r.kind != 'heading'"
							data-class-focused="focus == r.index" data-class-changed="r.changed"
							data-class-keyrow="r.kind == 'key'" data-class-tall="r.kind == 'crosshair'"
							data-event-mouseover="focus(r.index)">
						<div class="label" data-class-long="r.long_label">{{ r.label }}</div>
						<div class="control" data-rml="r.widget" data-event-change="changed(r.index)"
								data-event-click="clicked(r.index)"></div>
						<div class="key" data-if="r.kind == 'key'" data-class-waiting="capturing == r.index"
								data-event-click="capture(r.index)">{{ capturing == r.index ? key_prompt : r.value }}</div>
						<div class="undo" data-class-hidden="!r.changed" data-event-click="reset(r.index)"/>
					</div>
				</div>
				<div class="empty" data-if="rows.size == 0">[[Nothing found]]</div>
			</div>
		</div>

		<div class="info">
			<div class="info-body" data-if="focus >= 0">
				<h4>{{ focus_label }}</h4>
				<p>{{ focus_help }}</p>
				<div class="cost" data-if="focus_load != ''" data-class-high="focus_load_class == 'high'"
						data-class-medium="focus_load_class == 'medium'" data-class-low="focus_load_class == 'low'">
					<span class="cost-label">{{ focus_load_label }}</span>
					<div class="meter"><i class="b1"/><i class="b2"/><i class="b3"/></div>
					<span class="cost-word">{{ focus_load }}</span>
				</div>
				<p class="note" data-if="focus_note != ''">{{ focus_note }}</p>
				<p class="status" data-if="crosshair_status != ''">{{ crosshair_status }}</p>
			</div>
		</div>
	</div>
</body>
</rml>
