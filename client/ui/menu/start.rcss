/*
 * Стартовый экран: логотип и пункты меню крупным текстом у левого края, как
 * заглавный экран игры; правая половина оставлена небу. «Об Axis» — в правом
 * нижнем углу над версией, подтверждение выхода — окно поверх страницы.
 */

/* Тень лежит только под текстом: плотная у левого края, к середине экрана
   растворяется, и небо справа остаётся нетронутым */

body {
	align-items: flex-start;
	justify-content: center;
	decorator: linear-gradient(to right, #000000E0 0%, #000000C4 28%, #00000000 68%);
	box-sizing: border-box;
	padding: 40dp 56dp 40dp 56dp;
}

.hero {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	margin-top: -24dp;
}

.brand {
	display: block;
	margin-bottom: 44dp;
	margin-left: 4dp;
}

.brand img {
	width: 315dp;
	height: 120dp;
}

/* Пункты тянутся на ширину самого длинного: наведение справа от короткого
   слова попадает в него, а не в пустоту между пунктами */

.menu {
	display: flex;
	flex-direction: column;
	align-items: stretch;
}

/* Пункт — строка текста без рамки. Строка начинается у самого края экрана
   (выходит за отступ страницы), и при наведении из-под края под словом
   проступает акцентная дымка — градиент, тающий вправо; слово чуть подаётся
   вправо, остальные пункты глохнут. Нажатие двигает дальше. */

.item {
	position: relative;
	display: block;
	height: 70dp;
	margin-left: -56dp;
	padding-left: 56dp;
	cursor: pointer;
}

.item.apart {
	margin-top: 28dp;
}

.item .glow {
	position: absolute;
	top: 0;
	left: 0;
	width: 560dp;
	height: 70dp;
	decorator: linear-gradient(to right, #A78BFA5C 0%, #A78BFA24 40%, #A78BFA00 100%);
	opacity: 0;
	transform: translateX(-40dp);
	transition: opacity 0.22s linear-in-out, transform 0.32s cubic-out;
}

.word {
	display: block;
	font-size: 56dp;
	font-weight: 700;
	letter-spacing: 0dp;
	line-height: 70dp;
	white-space: nowrap;
	text-transform: uppercase;
	color: #F5F5F7;
	transform: translateX(0dp);
	transition: color 0.2s linear-in-out, transform 0.28s cubic-out;
}

.menu:hover .word {
	color: #86868B;
}

.menu:hover .item:hover .word {
	color: #F5F5F7;
	transform: translateX(14dp);
}

.item:hover .glow {
	opacity: 1;
	transform: translateX(0dp);
}

.menu:hover .item:active .word {
	transform: translateX(22dp);
}

/* «Об Axis» — в правом нижнем углу над строкой версии: сведения о сборке
   и ссылка на них лежат вместе, а столбик пунктов остаётся один */

.about-link {
	position: absolute;
	right: 14dp;
	bottom: 30dp;
	padding: 4dp 0;
	font-size: 13dp;
	color: #FFFFFFB3;
	cursor: pointer;
	transition: color 0.12s linear-in-out;
}

.about-link:hover {
	color: #FFFFFF;
}

/* Появление: логотип, пункты по одному и подпись въезжают слева. Задержка
   не через animation-delay — до его конца RmlUi держит элемент в покое,
   и пункты мигнули бы; каждый пункт вместо этого держит начало кадрами.
   Класс shown ставит и снимает Screen, чтобы въезд шёл при каждом возврате. */

body.shown .brand {
	animation: 0.8s cubic-out enter-brand;
}

body.shown .item:nth-child(1) {
	animation: 0.8s cubic-out enter-item-1;
}

body.shown .item:nth-child(2) {
	animation: 0.8s cubic-out enter-item-2;
}

body.shown .item:nth-child(3) {
	animation: 0.8s cubic-out enter-item-3;
}

body.shown .item:nth-child(4) {
	animation: 0.8s cubic-out enter-item-4;
}

body.shown .about-link {
	animation: 0.8s cubic-out enter-about;
}

@keyframes enter-brand {
	0% { opacity: 0; transform: translateX(-32dp); }
	60% { opacity: 1; transform: translateX(0dp); }
	100% { opacity: 1; transform: translateX(0dp); }
}

@keyframes enter-item-1 {
	0% { opacity: 0; transform: translateX(-48dp); }
	10% { opacity: 0; transform: translateX(-48dp); }
	55% { opacity: 1; transform: translateX(0dp); }
	100% { opacity: 1; transform: translateX(0dp); }
}

@keyframes enter-item-2 {
	0% { opacity: 0; transform: translateX(-48dp); }
	20% { opacity: 0; transform: translateX(-48dp); }
	65% { opacity: 1; transform: translateX(0dp); }
	100% { opacity: 1; transform: translateX(0dp); }
}

@keyframes enter-item-3 {
	0% { opacity: 0; transform: translateX(-48dp); }
	30% { opacity: 0; transform: translateX(-48dp); }
	75% { opacity: 1; transform: translateX(0dp); }
	100% { opacity: 1; transform: translateX(0dp); }
}

@keyframes enter-item-4 {
	0% { opacity: 0; transform: translateX(-48dp); }
	40% { opacity: 0; transform: translateX(-48dp); }
	85% { opacity: 1; transform: translateX(0dp); }
	100% { opacity: 1; transform: translateX(0dp); }
}

@keyframes enter-about {
	0% { opacity: 0; }
	60% { opacity: 0; }
	100% { opacity: 1; }
}

/* Окно поверх страницы: подложка размывается, а не только темнеет — за окном
   остаётся тот же экран, и размытие отнимает у него буквы, оставляя место,
   куда вернёшься. Тень у окна есть: оно висит над страницей. */

.scrim {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: #00000099;
	backdrop-filter: blur(8dp);
}

.modal {
	position: absolute;
	top: 50%;
	left: 50%;
	width: 420dp;
	box-sizing: border-box;
	margin: -90dp 0 0 -210dp;
	padding: 24dp;
	border-radius: 18dp;
	background-color: #1C1C1E;
	box-shadow: 0 4dp 12dp #00000073, 0 16dp 40dp -12dp #000000A6;
	display: flex;
	flex-direction: column;
}

.modal h2 {
	margin-bottom: 18dp;
}

.modal .check {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 24dp;
	font-size: 14dp;
	color: #A1A1A6;
}

.modal .check span {
	cursor: pointer;
}

.modal-actions {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
}

.modal-actions button {
	margin-left: 10dp;
	padding: 0 24dp;
}
