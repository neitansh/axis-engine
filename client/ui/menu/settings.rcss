/*
 * Экран настроек: вкладки-иконки сверху, строки в середине, описание строки
 * под курсором справа. Строка — подпись и один виджет одной высоты: ряд
 * значений листается стрелками, число тянется ползунком с заливкой.
 */

body.settings {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	justify-content: flex-start;
	background-color: #06050A99;
	backdrop-filter: blur(18dp);
	box-sizing: border-box;
	padding: 16dp 48dp 40dp 48dp;
}

/* Вкладки: иконки в тёмной размытой полосе, подпись — только под открытой */

.tabbar {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-bottom: 16dp;
}

.tabs {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	padding: 6dp 8dp;
	border-radius: 10dp;
	background-color: #00000073;
	backdrop-filter: blur(10dp);
}

.tabs .tab {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 44dp;
	margin: 0 3dp;
	cursor: pointer;
}

.tabs .tab img {
	width: 22dp;
	height: 22dp;
	margin: 6dp 0;
	padding: 5dp 11dp;
	border-radius: 8dp;
	image-color: #FFFFFFA6;
}

.tabs .tab:hover img {
	image-color: #FFFFFF;
	background-color: #FFFFFF12;
}

.tabs .tab.active img {
	image-color: #FFFFFF;
	background-color: #FFFFFF26;
}

.tabs .tab .caption {
	font-size: 10dp;
	font-weight: 600;
	letter-spacing: 1dp;
	color: #FFFFFF;
	white-space: nowrap;
	margin-bottom: 4dp;
}

/* Тело: строки и описание */

.settings-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
	padding: 0 48dp;
}

.rows {
	display: block;
	flex: 1;
	overflow-y: auto;
	padding-right: 16dp;
}

.rows scrollbarvertical {
	width: 4dp;
	margin: 0;
}

.rows scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF33;
}

.rows h3.group {
	display: block;
	font-size: 13dp;
	font-weight: 700;
	letter-spacing: 1.5dp;
	color: #FFFFFF;
	margin: 22dp 0 8dp 0;
}

.rows h3.group:first-child {
	margin-top: 0;
}

.setting {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 46dp;
	padding: 0 10dp 0 12dp;
	margin-bottom: 2dp;
	border-radius: 6dp;
	border: 1dp transparent;
}

.setting.tall {
	height: auto;
	align-items: flex-start;
	padding-top: 10dp;
	padding-bottom: 10dp;
}

.setting.focused {
	background-color: #FFFFFF0F;
	border-color: #A78BFA;
}

.setting .label {
	flex: 1;
	min-width: 0;
	font-size: 14dp;
	color: #E8E6ED;
	padding-right: 16dp;
	white-space: nowrap;
	overflow: hidden;
}

.setting.tall .label {
	padding-top: 8dp;
}

.setting .control {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	width: 260dp;
}

.setting.keyrow .control {
	width: 0;
}

.setting.tall .control {
	width: 460dp;
}

.setting button.key {
	width: 260dp;
	height: 34dp;
	padding: 0 12dp;
	line-height: 34dp;
	background-color: #E8E6ED;
	border-color: #E8E6ED;
	color: #0C0A12;
	font-size: 13dp;
}

.setting button.key:hover {
	background-color: #FFFFFF;
}

.setting button.key.waiting {
	background-color: #8B5CF6;
	border-color: #A78BFA;
	color: #FFFFFF;
}

.setting button.clear {
	width: 30dp;
	height: 34dp;
	margin-left: 6dp;
	padding: 0;
	line-height: 34dp;
	background-color: transparent;
	border-color: transparent;
	color: #C05B4D;
	font-size: 13dp;
}

.setting button.clear:hover {
	background-color: #C05B4D22;
}

.setting button.clear.hidden {
	visibility: hidden;
}

/* Ряд значений: стрелки, текущее и черта из отрезков под ним */

.stepper {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 260dp;
	height: 34dp;
	border-radius: 6dp;
	background-color: #0C0A12;
	border: 1dp #FFFFFF14;
	box-sizing: border-box;
}

.stepper .arrow {
	width: 30dp;
	height: 32dp;
	cursor: pointer;
	decorator: image(icons/chevron.png scale-none);
	image-color: #948C9E;
}

.stepper .arrow.next {
	transform: rotate(180deg);
}

.stepper .arrow:hover {
	image-color: #FFFFFF;
	background-color: #FFFFFF0C;
}

.stepper .middle {
	display: flex;
	flex-direction: column;
	align-items: center;
	flex: 1;
	min-width: 0;
}

.stepper .val {
	color: #FFFFFF;
	font-size: 13dp;
	line-height: 18dp;
	white-space: nowrap;
	overflow: hidden;
}

.stepper .segments {
	display: flex;
	flex-direction: row;
	width: 100%;
	padding: 0 8dp;
	margin-top: 2dp;
	box-sizing: border-box;
}

.stepper .segments i {
	display: block;
	flex: 1;
	height: 3dp;
	margin: 0 1dp;
	border-radius: 1dp;
	background-color: #FFFFFF24;
}

.stepper .segments i.on {
	background-color: #A78BFA;
}

/* Число: ползунок с заливкой и поле для точного значения */

.setting .control input.range {
	flex: 1;
	height: 34dp;
	border-radius: 6dp;
	background-color: #0C0A12;
	border: 1dp #FFFFFF14;
	margin-right: 6dp;
	box-sizing: border-box;
}

.setting .control input.range slidertrack {
	height: 32dp;
	background-color: transparent;
}

.setting .control input.range sliderprogress {
	height: 32dp;
	border-radius: 5dp 0 0 5dp;
	background-color: #8B5CF6;
}

.setting .control input.range sliderbar {
	width: 6dp;
	height: 32dp;
	background-color: #E8E6ED;
	cursor: pointer;
}

.setting .control input.range sliderbar:hover,
.setting .control input.range sliderbar:active {
	background-color: #FFFFFF;
}

.setting .control input.range sliderarrowdec,
.setting .control input.range sliderarrowinc {
	width: 0;
	height: 0;
}

.setting .control input.text {
	height: 34dp;
	line-height: 22dp;
	padding: 5dp 10dp;
	box-sizing: border-box;
	font-size: 13dp;
}

.setting .control input.text.num {
	width: 72dp;
	text-align: center;
}

.setting .control input.text.wide {
	width: 260dp;
}

.flags {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-end;
}

.flags label {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: 10dp;
	font-size: 12dp;
	color: #B9B3C4;
}

input.checkbox {
	width: 18dp;
	height: 18dp;
	border-radius: 4dp;
	background-color: #0C0A12;
	border: 1dp #FFFFFF3A;
	cursor: pointer;
	margin-right: 6dp;
}

input.checkbox:hover {
	border-color: #A78BFA;
}

input.checkbox:checked {
	background-color: #8B5CF6;
	border-color: #A78BFA;
	decorator: image(icons/check.png);
}

/* Перекрестье: предпросмотр, набор, цвета, обмен */

.xhair {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	width: 460dp;
}

.xhair-preview {
	position: relative;
	width: 96dp;
	height: 96dp;
	border-radius: 6dp;
	background-color: #0C0A12;
	border: 1dp #FFFFFF14;
	margin-right: 14dp;
}

.xhair-preview .piece {
	position: absolute;
	display: block;
}

.xhair-fields {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.xhair-fields .field {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 34dp;
	margin-bottom: 6dp;
}

.xhair-fields .field span {
	width: 90dp;
	font-size: 12dp;
	color: #B9B3C4;
}

.xhair-fields .field .stepper {
	flex: 1;
	width: auto;
}

.xhair-fields .field input.text.color {
	width: 110dp;
	margin-right: 8dp;
}

.xhair-fields .swatch {
	display: block;
	width: 22dp;
	height: 22dp;
	border-radius: 4dp;
	border: 1dp #FFFFFF3A;
}

.xhair-fields .field.share .button {
	display: block;
	padding: 6dp 14dp;
	margin-right: 8dp;
	border-radius: 6dp;
	background-color: #17131F;
	border: 1dp #FFFFFF24;
	color: #E8E6ED;
	font-size: 12dp;
	cursor: pointer;
}

.xhair-fields .field.share .button:hover {
	background-color: #211B2E;
}

button.more {
	margin: 16dp auto 8dp auto;
	background-color: transparent;
	border-color: #FFFFFF24;
	color: #948C9E;
}

/* Описание справа */

.info {
	display: flex;
	flex-direction: column;
	width: 320dp;
	margin-left: 28dp;
	padding-left: 24dp;
	border-left: 1dp #FFFFFF14;
}

.info input.text.search {
	height: 34dp;
	padding: 5dp 12dp;
	box-sizing: border-box;
	margin-bottom: 18dp;
	font-size: 13dp;
}

.info-body {
	display: flex;
	flex-direction: column;
}

.info h4 {
	display: block;
	font-size: 15dp;
	font-weight: 600;
	color: #FFFFFF;
	margin: 0 0 10dp 0;
}

.info p {
	color: #B9B3C4;
	font-size: 13dp;
	line-height: 1.5;
	margin-bottom: 12dp;
}

.info p.load {
	color: #F2C14E;
	font-size: 12dp;
}

.info p.note {
	color: #948C9E;
	font-size: 12dp;
}

.info p.status {
	color: #A78BFA;
	font-size: 12dp;
}

.info .options {
	display: flex;
	flex-direction: column;
}

.info .opt {
	padding: 4dp 10dp;
	font-size: 13dp;
	color: #726E7E;
}

.info .opt.on {
	color: #0C0A12;
	background-color: #E8E6ED;
	border-radius: 4dp;
}

/* Низ */

.bottom {
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	align-items: center;
	margin-top: 14dp;
	padding: 0 48dp;
}

.bottom button {
	margin-left: 8dp;
	height: 36dp;
	padding: 0 18dp;
	line-height: 36dp;
	font-size: 13dp;
}
