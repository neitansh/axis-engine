/*
 * Экран настроек: вкладки-иконки сверху, строки в карточке, описание строки
 * под курсором справа. Строка — подпись и один орган управления одной высоты:
 * ряд значений листается стрелками, число тянется ползунком с заливкой.
 * Страница, шапка и заголовки разделов — в page.rcss.
 */

/* Вкладки: дорожка цвета карточки, выбранная поднимается подсветкой акцента */

.tabs {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 4dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
}

.tabs .indicator {
	position: absolute;
	top: 4dp;
	left: 4dp;
	width: 50dp;
	height: 44dp;
	border-radius: 9dp;
	background-color: #221B36;
	transition: transform 0.25s cubic-out;
}

.tabs .tab {
	position: relative;
	width: 50dp;
	height: 44dp;
	margin: 0 3dp;
	cursor: pointer;
}

.tabs .tab img {
	position: absolute;
	top: 4dp;
	left: 0;
	width: 24dp;
	height: 24dp;
	padding: 6dp 13dp;
	image-color: #86868B;
	transition: transform 0.15s cubic-out, image-color 0.12s linear-in-out;
}

.tabs .tab:hover img {
	image-color: #F5F5F7;
	transform: translateY(-2dp);
}

.tabs .tab.active img {
	image-color: #A78BFA;
	transform: translateY(0);
}

.tabs .tab .caption {
	position: absolute;
	top: 52dp;
	left: -40dp;
	right: -40dp;
	text-align: center;
	font-size: 12dp;
	color: #86868B;
	white-space: nowrap;
}

/* Тело: строки в карточке и описание на странице */

.settings-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

.rows-frame {
	position: relative;
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
	border-radius: 18dp;
	background-color: #1C1C1E;
}

.rows {
	display: block;
	flex: 1;
	overflow-y: auto;
	padding: 6dp 16dp 16dp 24dp;
}

.rows scrollbarvertical {
	width: 4dp;
	margin: 8dp 4dp 8dp 0;
}

.rows scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF24;
}

.rows h3.group {
	margin: 10dp 0 6dp 0;
}

.setting {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 56dp;
	padding: 0 12dp;
	margin: 0 -12dp 2dp -12dp;
	border-radius: 12dp;
	transition: background-color 0.12s linear-in-out;
}

.setting.tall {
	height: auto;
	align-items: flex-start;
	padding-top: 10dp;
	padding-bottom: 10dp;
}

.setting.focused {
	background-color: #FFFFFF0A;
}

.setting .label {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
	font-size: 15dp;
	line-height: 24dp;
	color: #F5F5F7;
	padding-right: 16dp;
	white-space: nowrap;
	overflow: hidden;
	/* Длинная подпись не режется по букве, а тает у правого края */
	mask-image: linear-gradient(to right, #FFFFFF 78%, #FFFFFF00 100%);
}

.setting .label.long {
	font-size: 13dp;
}

.setting.tall .label {
	padding-top: 10dp;
}

.setting .control {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	width: 300dp;
}

.setting.keyrow .control {
	width: 0;
}

.setting.tall .control {
	width: 500dp;
}

/* Клавиша: поле, как ряд значений; ожидание ввода — акцентом */

.setting .key {
	width: 300dp;
	height: 44dp;
	line-height: 42dp;
	box-sizing: border-box;
	text-align: center;
	border-radius: 12dp;
	border: 1dp #38383A;
	color: #F5F5F7;
	font-size: 15dp;
	cursor: pointer;
	transition: border-color 0.12s linear-in-out, background-color 0.12s linear-in-out, color 0.12s linear-in-out;
}

.setting .key:hover {
	border-color: #A78BFA3D;
	background-color: #FFFFFF14;
}

.setting .key.waiting {
	background-color: #A78BFA;
	border-color: #A78BFA;
	color: #1C1C1E;
	font-weight: 600;
}

/* Откат к умолчанию: значковая кнопка */

.setting .undo {
	width: 36dp;
	height: 36dp;
	margin-left: 6dp;
	border-radius: 10dp;
	decorator: image(icons/reset.png scale-none);
	image-color: #86868B;
	cursor: pointer;
	transition: image-color 0.12s linear-in-out, background-color 0.12s linear-in-out;
}

.setting .undo:hover {
	image-color: #F5F5F7;
	background-color: #FFFFFF14;
}

.setting .undo.hidden {
	visibility: hidden;
}

/* Ряд значений: стрелки, текущее и черта из отрезков под ним */

.stepper {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 300dp;
	height: 44dp;
	border-radius: 12dp;
	border: 1dp #38383A;
	box-sizing: border-box;
}

.stepper .arrow {
	width: 36dp;
	height: 42dp;
	border-radius: 11dp;
	cursor: pointer;
	decorator: image(icons/chevron.png scale-none);
	image-color: #86868B;
	transition: image-color 0.12s linear-in-out, background-color 0.12s linear-in-out;
}

.stepper .arrow.next {
	transform: rotate(180deg);
}

.stepper .arrow:hover {
	image-color: #F5F5F7;
	background-color: #FFFFFF14;
}

.stepper .middle {
	display: flex;
	flex-direction: column;
	align-items: center;
	flex: 1;
	min-width: 0;
}

.stepper .val {
	color: #F5F5F7;
	font-size: 15dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
}

.stepper .segments {
	display: flex;
	flex-direction: row;
	width: 100%;
	padding: 0 8dp;
	margin-top: 2dp;
	box-sizing: border-box;
}

.stepper .segments i {
	display: block;
	flex: 1;
	height: 3dp;
	margin: 0 1dp;
	border-radius: 1dp;
	background-color: #38383A;
	transition: background-color 0.12s linear-in-out;
}

.stepper .segments i.on {
	background-color: #A78BFA;
}

/* Число: ползунок с заливкой и поле для точного значения */

/* Заливка заходит под маркер (поле справа сверх ширины, которую ставит
   RmlUi), чтобы в скруглённых углах маркера просвечивала она, а не дорожка;
   у краёв обоих обрезает сама дорожка по своим углам */
.setting .control input.range {
	flex: 1;
	height: 44dp;
	border-radius: 12dp;
	background-color: #2C2C2E;
	margin-right: 6dp;
	box-sizing: border-box;
	overflow: hidden;
}

.setting .control input.range slidertrack {
	height: 44dp;
	background-color: transparent;
}

.setting .control input.range sliderprogress {
	height: 44dp;
	padding-right: 7dp;
	background-color: #A78BFA;
}

.setting .control input.range sliderbar {
	width: 10dp;
	height: 44dp;
	border-radius: 5dp;
	background-color: #F5F5F7;
	cursor: pointer;
}

.setting .control input.range sliderarrowdec,
.setting .control input.range sliderarrowinc {
	width: 0;
	height: 0;
}

.setting .control input.text {
	background-color: transparent;
}

.setting .control input.text.num {
	width: 80dp;
	padding-left: 6dp;
	padding-right: 6dp;
	text-align: center;
}

.setting .control input.text.wide {
	width: 300dp;
}

.setting .control select {
	width: 300dp;
	background-color: transparent;
}

.setting .control select selectbox {
	height: 260dp;
	overflow-y: auto;
}

.flags {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-end;
}

.flags label {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: 12dp;
	font-size: 14dp;
	color: #A1A1A6;
}

/* Перекрестье: предпросмотр, набор, цвета, обмен */

.xhair {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	width: 500dp;
}

.xhair-preview {
	position: relative;
	width: 120dp;
	height: 120dp;
	border-radius: 12dp;
	background-color: #000000;
	margin-right: 14dp;
}

.xhair-preview .piece {
	position: absolute;
	display: block;
}

.xhair-fields {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.xhair-fields .field {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 44dp;
	margin-bottom: 6dp;
}

.xhair-fields .field span {
	width: 100dp;
	font-size: 14dp;
	color: #A1A1A6;
}

.xhair-fields .field .stepper {
	flex: 1;
	width: auto;
}

.xhair-fields .field input.text.color {
	width: 110dp;
	margin-right: 8dp;
	background-color: transparent;
}

.xhair-fields .swatch {
	display: block;
	width: 22dp;
	height: 22dp;
	border-radius: 6dp;
	border: 1dp #38383A;
}

.xhair-fields .field.share .button {
	display: block;
	height: 36dp;
	line-height: 34dp;
	box-sizing: border-box;
	padding: 0 16dp;
	margin-right: 8dp;
	border-radius: 18dp;
	border: 1dp #38383A;
	color: #F5F5F7;
	font-size: 14dp;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out;
}

.xhair-fields .field.share .button:hover {
	background-color: #FFFFFF14;
}

/* Описание справа */

.info {
	display: flex;
	flex-direction: column;
	width: 320dp;
	margin-left: 32dp;
	padding-top: 6dp;
}

.info-body {
	display: flex;
	flex-direction: column;
}

.info h4 {
	display: block;
	font-size: 18dp;
	font-weight: 500;
	color: #F5F5F7;
	margin: 0 0 8dp 0;
}

.info p {
	color: #A1A1A6;
	font-size: 14dp;
	line-height: 1.55;
	margin-bottom: 12dp;
}

.cost {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 14dp;
	padding: 10dp 14dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
}

.cost .cost-label {
	font-size: 13dp;
	color: #86868B;
	margin-right: 10dp;
}

.cost .meter {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	height: 16dp;
	margin-right: 10dp;
}

.cost .meter i {
	display: block;
	width: 6dp;
	margin-right: 3dp;
	border-radius: 2dp;
	background-color: #38383A;
}

.cost .meter i.b1 { height: 8dp; }
.cost .meter i.b2 { height: 12dp; }
.cost .meter i.b3 { height: 16dp; }

.cost.low .meter i.b1 { background-color: #30D158; }
.cost.medium .meter i.b1,
.cost.medium .meter i.b2 { background-color: #FF9F0A; }
.cost.high .meter i.b1,
.cost.high .meter i.b2,
.cost.high .meter i.b3 { background-color: #FF453A; }

.cost .cost-word {
	font-size: 14dp;
	font-weight: 600;
}

.cost.low .cost-word { color: #30D158; }
.cost.medium .cost-word { color: #FF9F0A; }
.cost.high .cost-word { color: #FF453A; }

.info p.note {
	color: #86868B;
	font-size: 13dp;
}

.info p.status {
	color: #A78BFA;
	font-size: 14dp;
}
