/*
 * Экран настроек: вкладки-иконки сверху, строки в середине, описание строки
 * под курсором справа. Строка — подпись и один виджет одной высоты: ряд
 * значений листается стрелками, число тянется ползунком с заливкой.
 */

@keyframes caption-in {
	from { opacity: 0; transform: translateY(-6dp); }
	to { opacity: 1; transform: translateY(0); }
}

@keyframes fade-in {
	from { opacity: 0; }
	to { opacity: 1; }
}

body.settings {
	position: absolute;
	/* Размытие у RmlUi отступает от краёв элемента на свой радиус, поэтому
	   тело выходит за экран, а поля возвращают содержимое на место. */
	top: -40dp;
	left: -40dp;
	right: -40dp;
	bottom: -40dp;
	width: auto;
	height: auto;
	display: flex;
	flex-direction: column;
	align-items: stretch;
	justify-content: flex-start;
	background-color: #06050A73;
	backdrop-filter: blur(26dp);
	box-sizing: border-box;
	padding: 62dp 88dp 40dp 88dp;
	font-size: 16dp;
}

/* Назад: стеклянная кнопка в левом верхнем углу; стрелка уезжает при наведении */

.back {
	position: absolute;
	top: 62dp;
	left: 80dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 40dp;
	padding: 0 14dp 0 10dp;
	border-radius: 20dp;
	background-color: #00000040;
	border: 1dp #FFFFFF1F;
	backdrop-filter: blur(8dp);
	color: #E8E6ED;
	font-size: 15dp;
	cursor: pointer;
	transition: border-color 0.15s linear-in-out, background-color 0.15s linear-in-out, color 0.15s linear-in-out;
}

.back .arrow {
	width: 20dp;
	height: 20dp;
	margin-right: 8dp;
	decorator: image(icons/back.png scale-none);
	image-color: #E8E6ED;
	transition: transform 0.18s cubic-out, image-color 0.15s linear-in-out;
}

.back .hint {
	margin-left: 10dp;
	padding: 1dp 6dp;
	border-radius: 4dp;
	background-color: #FFFFFF14;
	font-size: 11dp;
	letter-spacing: 0.5dp;
	color: #948C9E;
}

.back:hover {
	color: #FFFFFF;
	border-color: #A78BFA99;
	background-color: #8B5CF626;
}

.back:hover .arrow {
	image-color: #FFFFFF;
	transform: translateX(-4dp);
}

/* Вкладки: стеклянная полоса, подсветка скользит к открытой иконке, подпись
   висит под ней */

.tabbar {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-bottom: 48dp;
}

.tabs {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 6dp 8dp;
	border-radius: 16dp;
	background-color: #00000040;
	border: 1dp #FFFFFF1A;
	backdrop-filter: blur(8dp);
	box-shadow: 0 10dp 30dp #00000059;
}

.tabs .indicator {
	position: absolute;
	top: 6dp;
	left: 11dp;
	width: 50dp;
	height: 50dp;
	border-radius: 12dp;
	background-color: #8B5CF633;
	border: 1dp #A78BFA80;
	transition: transform 0.25s cubic-out;
}

.tabs .tab {
	position: relative;
	width: 50dp;
	height: 50dp;
	margin: 0 3dp;
	cursor: pointer;
}

.tabs .tab img {
	position: absolute;
	top: 7dp;
	left: 0;
	width: 24dp;
	height: 24dp;
	padding: 6dp 13dp;
	image-color: #FFFFFF8C;
	transition: transform 0.15s cubic-out, image-color 0.15s linear-in-out;
}

.tabs .tab:hover img {
	image-color: #FFFFFF;
	transform: translateY(-2dp);
}

.tabs .tab.active img {
	image-color: #FFFFFF;
	transform: translateY(0);
}

.tabs .tab .caption {
	position: absolute;
	top: 58dp;
	left: -40dp;
	right: -40dp;
	text-align: center;
	font-size: 12dp;
	font-weight: 600;
	letter-spacing: 1dp;
	padding-left: 1dp;
	color: #FFFFFF;
	white-space: nowrap;
	animation: 0.2s cubic-out caption-in;
}

/* Тело: строки и описание */

.settings-body {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
	padding: 0 40dp;
}

.rows-frame {
	position: relative;
	display: flex;
	flex-direction: column;
	flex: 1;
	min-height: 0;
}

.rows {
	display: block;
	flex: 1;
	overflow-y: auto;
	padding-right: 16dp;
	padding-bottom: 48dp;
}

.rows-fade {
	position: absolute;
	left: 0;
	right: 0;
	bottom: 40dp;
	height: 80dp;
	decorator: linear-gradient(to bottom, #0B0A1200 0%, #0B0A1299 100%);
	pointer-events: none;
}

.rows scrollbarvertical {
	width: 4dp;
	margin: 0;
}

.rows scrollbarvertical sliderbar {
	border-radius: 2dp;
	background-color: #FFFFFF33;
}

.rows h3.group {
	display: block;
	font-size: 26dp;
	font-weight: 700;
	letter-spacing: 4dp;
	color: #A78BFA;
	margin: 34dp 0 14dp 0;
	animation: 0.25s cubic-out fade-in;
}

.rows h3.group:first-child {
	margin-top: 4dp;
}

.setting {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 54dp;
	padding: 0 10dp 0 14dp;
	margin-bottom: 2dp;
	border-radius: 6dp;
	border: 1dp transparent;
	transition: background-color 0.12s linear-in-out, border-color 0.12s linear-in-out;
}

.setting.tall {
	height: auto;
	align-items: flex-start;
	padding-top: 10dp;
	padding-bottom: 10dp;
}

.setting.focused {
	background-color: #FFFFFF0F;
	border-color: #A78BFA;
}

.setting .label {
	flex: 1;
	min-width: 0;
	font-size: 16dp;
	color: #F2F0F5;
	padding-right: 16dp;
	white-space: nowrap;
	overflow: hidden;
}

.setting.tall .label {
	padding-top: 8dp;
}

.setting .control {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	width: 300dp;
}

.setting.keyrow .control {
	width: 0;
}

.setting.tall .control {
	width: 500dp;
}

/* Клавиша: тёмная плашка, как ряд значений; ожидание ввода — акцентом */

.setting .key {
	width: 300dp;
	height: 40dp;
	line-height: 38dp;
	box-sizing: border-box;
	text-align: center;
	border-radius: 6dp;
	background-color: #1B1626;
	border: 1dp #FFFFFF14;
	color: #F2F0F5;
	font-size: 15dp;
	cursor: pointer;
	transition: border-color 0.15s linear-in-out, background-color 0.15s linear-in-out;
}

.setting .key:hover {
	border-color: #A78BFA;
}

.setting .key.waiting {
	background-color: #8B5CF6;
	border-color: #A78BFA;
	color: #FFFFFF;
}

/* Откат к умолчанию */

.setting .undo {
	width: 32dp;
	height: 40dp;
	margin-left: 6dp;
	border-radius: 6dp;
	decorator: image(icons/reset.png scale-none);
	image-color: #948C9E;
	cursor: pointer;
	transition: image-color 0.15s linear-in-out, background-color 0.15s linear-in-out;
}

.setting .undo:hover {
	image-color: #FFFFFF;
	background-color: #FFFFFF14;
}

.setting .undo.hidden {
	visibility: hidden;
}

/* Ряд значений: стрелки, текущее и черта из отрезков под ним */

.stepper {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 300dp;
	height: 40dp;
	border-radius: 6dp;
	background-color: #1B1626;
	box-sizing: border-box;
}

.stepper .arrow {
	width: 34dp;
	height: 40dp;
	border-radius: 6dp;
	cursor: pointer;
	decorator: image(icons/chevron.png scale-none);
	image-color: #948C9E;
	transition: image-color 0.12s linear-in-out, background-color 0.12s linear-in-out;
}

.stepper .arrow.next {
	transform: rotate(180deg);
}

.stepper .arrow:hover {
	image-color: #FFFFFF;
	background-color: #FFFFFF14;
}

.stepper .middle {
	display: flex;
	flex-direction: column;
	align-items: center;
	flex: 1;
	min-width: 0;
}

.stepper .val {
	color: #FFFFFF;
	font-size: 15dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
}

.stepper .segments {
	display: flex;
	flex-direction: row;
	width: 100%;
	padding: 0 8dp;
	margin-top: 2dp;
	box-sizing: border-box;
}

.stepper .segments i {
	display: block;
	flex: 1;
	height: 3dp;
	margin: 0 1dp;
	border-radius: 1dp;
	background-color: #FFFFFF24;
	transition: background-color 0.15s linear-in-out;
}

.stepper .segments i.on {
	background-color: #A78BFA;
}

/* Число: ползунок с заливкой и поле для точного значения */

.setting .control input.range {
	flex: 1;
	height: 40dp;
	border-radius: 6dp;
	background-color: #1B1626;
	margin-right: 6dp;
	box-sizing: border-box;
}

.setting .control input.range slidertrack {
	height: 40dp;
	background-color: transparent;
}

.setting .control input.range sliderprogress {
	height: 40dp;
	border-radius: 6dp 0 0 6dp;
	background-color: #8B5CF6;
}

.setting .control input.range sliderbar {
	width: 4dp;
	height: 40dp;
	border-radius: 2dp;
	background-color: #FFFFFF;
	cursor: pointer;
}

.setting .control input.range sliderarrowdec,
.setting .control input.range sliderarrowinc {
	width: 0;
	height: 0;
}

.setting .control input.text {
	height: 40dp;
	line-height: 24dp;
	padding: 7dp 12dp;
	box-sizing: border-box;
	border-radius: 6dp;
	background-color: #1B1626;
	border: 1dp transparent;
	font-size: 15dp;
	transition: border-color 0.15s linear-in-out;
}

.setting .control input.text:hover {
	border-color: #FFFFFF24;
}

.setting .control input.text:focus {
	border-color: #A78BFA;
}

.setting .control input.text.num {
	width: 80dp;
	text-align: center;
}

.setting .control input.text.wide {
	width: 300dp;
}

/* Список: для длинных рядов значений */

.setting .control select {
	width: 300dp;
	height: 40dp;
	line-height: 24dp;
	padding: 7dp 12dp;
	box-sizing: border-box;
	border-radius: 6dp;
	background-color: #1B1626;
	border: 1dp transparent;
	font-size: 15dp;
	color: #FFFFFF;
	cursor: pointer;
	transition: border-color 0.15s linear-in-out;
}

.setting .control select:hover {
	border-color: #FFFFFF24;
}

.setting .control select selectvalue {
	padding-right: 24dp;
}

.setting .control select selectarrow {
	width: 34dp;
	height: 38dp;
	margin: -7dp -12dp 0 -34dp;
	decorator: image(icons/chevron.png scale-none);
	image-color: #948C9E;
	transform: rotate(-90deg);
}

.setting .control select selectbox {
	margin-top: 4dp;
	padding: 4dp 0;
	height: 260dp;
	overflow-y: auto;
	border-radius: 6dp;
	background-color: #17131F;
	border: 1dp #FFFFFF14;
}

.setting .control select selectbox option {
	padding: 8dp 14dp;
	font-size: 15dp;
	color: #C8C3D1;
	cursor: pointer;
}

.setting .control select selectbox option:hover {
	background-color: #FFFFFF0C;
	color: #FFFFFF;
}

.setting .control select selectbox option:checked {
	color: #A78BFA;
}

.flags {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-end;
}

.flags label {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: 10dp;
	font-size: 14dp;
	color: #B9B3C4;
}

input.checkbox {
	width: 18dp;
	height: 18dp;
	border-radius: 4dp;
	background-color: #1B1626;
	border: 1dp #FFFFFF3A;
	cursor: pointer;
	margin-right: 6dp;
	transition: border-color 0.15s linear-in-out, background-color 0.15s linear-in-out;
}

input.checkbox:hover {
	border-color: #A78BFA;
}

input.checkbox:checked {
	background-color: #8B5CF6;
	border-color: #A78BFA;
	decorator: image(icons/check.png);
}

/* Перекрестье: предпросмотр, набор, цвета, обмен */

.xhair {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	width: 500dp;
}

.xhair-preview {
	position: relative;
	width: 120dp;
	height: 120dp;
	border-radius: 6dp;
	background-color: #1B1626;
	margin-right: 14dp;
}

.xhair-preview .piece {
	position: absolute;
	display: block;
}

.xhair-fields {
	display: flex;
	flex-direction: column;
	flex: 1;
}

.xhair-fields .field {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 40dp;
	margin-bottom: 6dp;
}

.xhair-fields .field span {
	width: 100dp;
	font-size: 14dp;
	color: #B9B3C4;
}

.xhair-fields .field .stepper {
	flex: 1;
	width: auto;
}

.xhair-fields .field input.text.color {
	width: 110dp;
	margin-right: 8dp;
}

.xhair-fields .swatch {
	display: block;
	width: 22dp;
	height: 22dp;
	border-radius: 4dp;
	border: 1dp #FFFFFF3A;
}

.xhair-fields .field.share .button {
	display: block;
	height: 40dp;
	line-height: 38dp;
	box-sizing: border-box;
	padding: 0 14dp;
	margin-right: 8dp;
	border-radius: 6dp;
	background-color: #1B1626;
	border: 1dp #FFFFFF14;
	color: #E8E6ED;
	font-size: 14dp;
	cursor: pointer;
	transition: border-color 0.15s linear-in-out;
}

.xhair-fields .field.share .button:hover {
	border-color: #A78BFA;
}

/* Описание справа */

.info {
	display: flex;
	flex-direction: column;
	width: 340dp;
	margin-left: 28dp;
	padding-left: 24dp;
	border-left: 1dp #FFFFFF14;
}

.info-body {
	display: flex;
	flex-direction: column;
	animation: 0.2s cubic-out fade-in;
}

.info h4 {
	display: block;
	font-size: 19dp;
	font-weight: 600;
	color: #FFFFFF;
	margin: 0 0 10dp 0;
}

.info p {
	color: #C8C3D1;
	font-size: 15dp;
	line-height: 1.55;
	margin-bottom: 12dp;
}

.cost {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 14dp;
	padding: 8dp 12dp;
	border-radius: 8dp;
	background-color: #FFFFFF0A;
	animation: 0.2s cubic-out fade-in;
}

.cost .cost-label {
	font-size: 13dp;
	color: #948C9E;
	margin-right: 10dp;
}

.cost .meter {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	height: 16dp;
	margin-right: 10dp;
}

.cost .meter i {
	display: block;
	width: 6dp;
	margin-right: 3dp;
	border-radius: 2dp;
	background-color: #FFFFFF24;
}

.cost .meter i.b1 { height: 8dp; }
.cost .meter i.b2 { height: 12dp; }
.cost .meter i.b3 { height: 16dp; }

.cost.low .meter i.b1 { background-color: #8BD6A0; }
.cost.medium .meter i.b1,
.cost.medium .meter i.b2 { background-color: #F2C14E; }
.cost.high .meter i.b1,
.cost.high .meter i.b2,
.cost.high .meter i.b3 { background-color: #FF8A75; }

.cost .cost-word {
	font-size: 14dp;
	font-weight: 600;
}

.cost.low .cost-word { color: #8BD6A0; }
.cost.medium .cost-word { color: #F2C14E; }
.cost.high .cost-word { color: #FF8A75; }

.info p.note {
	color: #948C9E;
	font-size: 14dp;
}

.info p.status {
	color: #A78BFA;
	font-size: 14dp;
}
