<rml>
<head>
	<title>worlds</title>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="page.rcss"/>
	<link type="text/rcss" href="worlds.rcss"/>
</head>
<body data-model="worlds" class="page play">
	<div class="page-head">
		<div class="back" data-event-click="nav('start')"><div class="arrow"/></div>
		<h1>[[Singleplayer]]</h1>
		<span class="kbd">Esc</span>
	</div>

	<div class="no-crates" data-if="crates.size == 0">
		<div class="mark"/>
		<h4>[[No crates yet]]</h4>
		<p>[[The engine decides how the game works; a crate decides what is in it — the rules, the items, the look. Install a crate, and you can create a world here.]]</p>
	</div>

	<div class="play-body" data-if="crates.size > 0">
		<div class="crates">
			<div class="eyebrow">{{ crate_heading }}</div>
			<div class="crate" data-for="c : crates" data-class-active="it_index == crate"
					data-event-click="select_crate(it_index)">
				<img class="icon" data-if="c.icon != ''" data-attr-src="c.icon"/>
				<div class="tile" data-if="c.icon == ''">{{ c.initial }}</div>
				<div class="text">
					<div class="name">{{ c.title }}</div>
					<div class="meta" data-if="c.author != ''">{{ c.author }}</div>
				</div>
				<div class="count" data-if="c.worlds > 0">{{ c.worlds }}</div>
			</div>
		</div>

		<div class="worlds">
			<h3 class="group">{{ worlds_heading }}</h3>
			<div class="world-list">
				<div class="world" data-for="w : worlds" data-class-active="it_index == selected"
						data-event-click="select(it_index)" data-event-dblclick="play()">
					<div class="name">{{ w.name }}</div>
					<div class="meta" data-if="w.mapgen != ''">{{ w.mapgen }}</div>
				</div>
				<div class="empty" data-if="worlds.size == 0">[[No worlds yet — create the first one]]</div>
			</div>
			<div class="list-actions">
				<button class="new" data-event-click="create_begin()"><span class="plus"/><span>[[New world]]</span></button>
			</div>
		</div>

		<div class="side">
			<div class="side-body" data-if="creating">
				<h4>[[New world]]</h4>
				<label>[[Name]]</label>
				<input type="text" data-value="new_name" maxlength="64"/>
				<label data-if="mapgens.size > 1">[[Map generator]]</label>
				<select data-if="mapgens.size > 1" data-value="new_mapgen">
					<option data-for="m : mapgens" data-attr-value="m">{{ m }}</option>
				</select>
				<label>[[Seed]]</label>
				<input type="text" data-value="new_seed" maxlength="64"/>
				<p class="hint">[[Leave the seed empty for a random world.]]</p>
				<p class="error" data-if="error != ''">{{ error }}</p>
				<button class="primary big" data-event-click="create()">[[Create]]</button>
				<button class="ghost" data-event-click="create_cancel()">[[Cancel]]</button>
			</div>

			<div class="side-body" data-if="!creating && selected >= 0">
				<h4>{{ selected_name }}</h4>
				<div class="facts">
					<div class="fact" data-if="selected_mapgen != ''">
						<span class="k">[[Map generator]]</span><span class="v">{{ selected_mapgen }}</span>
					</div>
				</div>
				<p class="error" data-if="error != ''">{{ error }}</p>
				<div data-if="!confirm_delete">
					<button class="primary big" data-event-click="play()">[[Play]]</button>
					<button class="ghost" data-event-click="delete_begin()">[[Delete]]</button>
				</div>
				<div class="confirm" data-if="confirm_delete">
					<p>{{ delete_question }}</p>
					<button class="danger" data-event-click="delete()">[[Delete]]</button>
					<button class="ghost" data-event-click="delete_cancel()">[[Keep]]</button>
				</div>
			</div>

			<div class="side-body" data-if="!creating && selected < 0">
				<h4>[[No world yet]]</h4>
				<p class="hint">[[Create a world for this crate and it will show up here.]]</p>
				<p class="error" data-if="error != ''">{{ error }}</p>
				<button class="primary big" data-event-click="create_begin()">[[New world]]</button>
			</div>
		</div>
	</div>
</body>
</rml>
