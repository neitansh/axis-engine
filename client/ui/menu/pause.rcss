/*
 * Пауза поверх игры: мир притушен, карточка по центру — заголовок и столбик
 * кнопок. Одна на все крейты; крейт сможет положить свой pause.rml.
 */

body.pause {
	display: flex;
	align-items: center;
	justify-content: center;
}

.pause .scrim {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: #000000A6;
}

.pause .card {
	position: relative;
	display: flex;
	flex-direction: column;
	width: 360dp;
	box-sizing: border-box;
	padding: 28dp 28dp 24dp 28dp;
	border-radius: 18dp;
	background-color: #1C1C1E;
}

.pause h1 {
	margin-bottom: 22dp;
}

.pause .actions {
	display: flex;
	flex-direction: column;
}

.pause .actions button {
	margin-bottom: 8dp;
}

.pause .actions button.big {
	font-size: 16dp;
	margin-bottom: 14dp;
}

/* Появление: карточка проступает и чуть подрастает */

body.shown .card {
	animation: 0.22s cubic-out pause-in;
}

@keyframes pause-in {
	0% { opacity: 0; transform: scale(0.96); }
	100% { opacity: 1; transform: scale(1); }
}
