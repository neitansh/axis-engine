<rml>
<head>
	<title>start</title>
	<link type="text/rcss" href="theme.rcss"/>
	<link type="text/rcss" href="start.rcss"/>
</head>
<body data-model="start">
	<div class="brand">
		<img src="textures/base/pack/menu_header.png" rect="483 0 378 144"/>
	</div>
	<div class="stack">
		<button class="primary" data-event-click="nav('online')">[[Multiplayer]]</button>
		<button class="solid" data-event-click="nav('worlds')">[[Singleplayer]]</button>
		<button class="solid" data-event-click="nav('settings')">[[Settings]]</button>
		<button class="solid" data-event-click="quit_begin()">[[Exit]]</button>
	</div>
	<div class="about-link" data-event-click="nav('about')">[[About]]</div>

	<div class="scrim" data-if="confirm_exit" data-event-click="quit_cancel()"/>
	<div class="modal" data-if="confirm_exit">
		<h2>[[Quit the game?]]</h2>
		<div class="check">
			<input type="checkbox" data-checked="ask_always" data-event-change="ask_toggle()"/>
			<span data-event-click="ask_flip()">[[Always ask before quitting]]</span>
		</div>
		<div class="modal-actions">
			<button data-event-click="quit_cancel()">[[Cancel]]</button>
			<button class="danger" data-event-click="quit_confirm()">[[Quit]]</button>
		</div>
	</div>
</body>
</rml>
