/*
 * Заставка при запуске: чёрный экран, карточки по центру — студия, движок.
 * Экран ставит карточке класс on; она проявляется и чуть подрастает, а без
 * класса гаснет переходом. Что и когда показывать — решает экран, тема
 * отвечает только за вид.
 */

body {
	background-color: #000000;
}

.card {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	opacity: 0;
	transition: opacity 0.4s linear-in-out;
}

.card.on {
	opacity: 1;
	animation: 1.6s cubic-out card-in;
}

@keyframes card-in {
	0% { transform: scale(0.94) translateY(10dp); }
	100% { transform: scale(1) translateY(0dp); }
}

.ivy {
	width: 96dp;
	height: 96dp;
	margin-bottom: 22dp;
}

.wordmark {
	font-size: 40dp;
	font-weight: 700;
	letter-spacing: -2dp;
	line-height: 1;
	color: #F5F5F7;
}

.wordmark .green {
	color: #5BA363;
}

.tag {
	margin-top: 14dp;
	font-family: "Departure Mono";
	font-size: 11dp;
	letter-spacing: 3dp;
	color: #86868B;
}

.axis {
	width: 315dp;
	height: 120dp;
	margin-bottom: 18dp;
}

.stamp {
	font-family: "Departure Mono";
	font-size: 13dp;
	color: #A1A1A6;
}

.hint {
	position: absolute;
	right: 32dp;
	bottom: 28dp;
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 16dp;
	color: #A1A1A6;
}

/* Стрелка подзывает: качается вправо-влево */

.hint .arrow {
	margin-left: 10dp;
	font-size: 20dp;
	color: #F5F5F7;
	animation: 1.2s cubic-in-out infinite alternate hint-nudge;
}

@keyframes hint-nudge {
	0% { transform: translateX(0dp); }
	100% { transform: translateX(6dp); }
}
