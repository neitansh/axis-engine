/*
 * Тема главного меню по умолчанию. Три уровня поверхностей (panel < surface
 * < inset), один фиолетовый акцент на главное действие экрана, остальное
 * нейтральное; те же цвета живут в лаунчере и на сайте.
 */

body {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	font-family: "Inter Variable";
	font-size: 16dp;
	line-height: 1.4;
	color: #E8E6ED;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

h1 {
	display: block;
	font-family: "Departure Mono";
	font-size: 56dp;
	line-height: 1;
	color: #A78BFA;
	margin: 0 0 4dp 0;
}

h2 {
	display: block;
	font-family: "Departure Mono";
	font-size: 22dp;
	color: #A78BFA;
	margin: 0 0 16dp 0;
}

p {
	display: block;
	margin: 0;
}

.muted {
	color: #948C9E;
}

.dim {
	color: #726E7E;
	font-size: 13dp;
}

.brand {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 36dp;
}

.brand img {
	width: 378dp;
	height: 144dp;
}

.version {
	position: absolute;
	right: 14dp;
	bottom: 10dp;
	font-size: 12dp;
	letter-spacing: 0.5dp;
	color: #FFFFFFB3;
}

.stack {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	width: 300dp;
}

.stack button {
	margin-bottom: 10dp;
}

button {
	display: block;
	padding: 12dp 20dp;
	border-radius: 6dp;
	background-color: #17131F;
	border: 1dp #FFFFFF24;
	color: #E8E6ED;
	text-align: center;
	cursor: pointer;
	transition: background-color 0.12s, border-color 0.12s;
}

button:hover {
	background-color: #211B2E;
	border-color: #FFFFFF3A;
}

button:active {
	background-color: #120F19;
}

button.primary {
	background-color: #8B5CF6;
	border-color: #A78BFA;
	color: #FFFFFF;
}

button.primary:hover {
	background-color: #9B72F8;
}

button.primary:active {
	background-color: #7C4FE0;
}

button.ghost {
	background-color: transparent;
	border-color: transparent;
	color: #948C9E;
}

button.ghost:hover {
	color: #E8E6ED;
	background-color: #FFFFFF0C;
}









.empty {
	padding: 24dp;
	text-align: center;
	color: #726E7E;
}

.notice {
	display: flex;
	flex-direction: row;
	align-items: center;
	/* Ширина твёрдая: у flex-элемента с max-width RmlUi считает высоту до
	   того, как ужмёт ширину, и текст вылезает из рамки */
	width: 520dp;
	box-sizing: border-box;
	margin-bottom: 24dp;
	padding: 10dp 14dp;
	border-radius: 8dp;
	background-color: #C05B4D33;
	border: 1dp #C05B4D80;
	backdrop-filter: blur(8dp);
	color: #FFFFFF;
	font-size: 15dp;
	line-height: 1.45;
}

.notice p {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
}

.notice button {
	padding: 4dp 10dp;
	margin-left: 12dp;
}

scrollbarvertical {
	width: 8dp;
	margin: 2dp;
}

scrollbarvertical slidertrack {
	background-color: transparent;
}

scrollbarvertical sliderbar {
	border-radius: 4dp;
	background-color: #FFFFFF24;
}

scrollbarvertical sliderbar:hover {
	background-color: #FFFFFF3A;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}





button.danger {
	background-color: #C05B4D;
	border-color: #D57365;
	color: #FFFFFF;
}

button.danger:hover {
	background-color: #CE6C5E;
}



input.text,
select {
	display: block;
	padding: 8dp 12dp;
	border-radius: 6dp;
	background-color: #0C0A12;
	border: 1dp #FFFFFF24;
	color: #E8E6ED;
}

input.text:focus,
select:focus {
	border-color: #A78BFA;
}

input.text {
	cursor: text;
	caret-color: #A78BFA;
}

select {
	cursor: pointer;
}

select selectvalue {
	padding-right: 24dp;
}

select selectarrow {
	width: 12dp;
	height: 12dp;
	margin: 3dp 0 0 -18dp;
	decorator: text("▼");
	font-size: 10dp;
	color: #948C9E;
}

select selectbox {
	margin-top: 4dp;
	padding: 4dp 0;
	border-radius: 6dp;
	background-color: #17131F;
	border: 1dp #FFFFFF24;
}

select selectbox option {
	padding: 6dp 12dp;
	cursor: pointer;
}

select selectbox option:hover {
	background-color: #FFFFFF0C;
}

select selectbox option:checked {
	color: #A78BFA;
}

.error {
	margin-top: 12dp;
	color: #E08A7E;
}

.confirm {
	display: flex;
	flex-direction: column;
	margin-top: 16dp;
	padding: 12dp 14dp;
	border-radius: 6dp;
	background-color: #C05B4D1A;
	border: 1dp #C05B4D66;
}

.confirm p {
	margin-bottom: 10dp;
}

