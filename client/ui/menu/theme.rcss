/*
 * Тема главного меню — та же, что у сайта и лаунчера (packages/axis-shared/
 * styles/theme.css, тёмная): плоскость, воздух и один акцент. Ни у чего, что
 * лежит на странице, нет ни тени, ни стекла; карточка отделяется от страницы
 * своим цветом, строки внутри неё — швом.
 *
 * У RCSS нет переменных, поэтому цвета записаны числами. Словарь:
 *   страница   #000000     карточка #1C1C1E   кайма #38383A   шов #2C2C2E
 *   акцент     #A78BFA     на акценте #1C1C1E  подсветка акцента #221B36
 *   текст      #F5F5F7     тише #A1A1A6       подсказка #86868B
 *   наведение  #FFFFFF14   в сети #30D158     тревога #FF9F0A   опасно #FF453A
 *   скругления: орган управления 12dp, карточка 18dp, кнопка — пилюля
 *   высота органа управления 44dp
 */

body {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	font-family: "Inter Variable";
	font-size: 15dp;
	line-height: 1.4;
	color: #F5F5F7;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

h1 {
	display: block;
	font-size: 30dp;
	font-weight: 700;
	letter-spacing: -0.5dp;
	line-height: 1.1;
	color: #F5F5F7;
	margin: 0;
}

h2 {
	display: block;
	font-size: 18dp;
	color: #F5F5F7;
	margin: 0 0 16dp 0;
}

p {
	display: block;
	margin: 0;
}

.muted {
	color: #A1A1A6;
}

.dim {
	color: #86868B;
	font-size: 13dp;
}

.brand {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-bottom: 36dp;
}

.brand img {
	width: 378dp;
	height: 144dp;
}

.version {
	position: absolute;
	right: 14dp;
	bottom: 10dp;
	font-family: "Departure Mono";
	font-size: 12dp;
	color: #FFFFFFB3;
}

.stack {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	width: 300dp;
}

.stack button {
	margin-bottom: 10dp;
}

/* Кнопки — пилюли. Главное действие экрана заливается акцентом, остальные
   держатся каймой; на небе стартового экрана кайма одна не видна, и там
   второстепенная кнопка берёт цвет карточки. */

button {
	display: block;
	height: 44dp;
	line-height: 42dp;
	box-sizing: border-box;
	padding: 0 20dp;
	border-radius: 22dp;
	background-color: transparent;
	border: 1dp #38383A;
	color: #F5F5F7;
	font-size: 15dp;
	text-align: center;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out, border-color 0.12s linear-in-out, color 0.12s linear-in-out, opacity 0.12s linear-in-out;
}

button:hover {
	background-color: #FFFFFF14;
}

button:active {
	background-color: #FFFFFF1F;
}

button.primary {
	background-color: #A78BFA;
	border-color: #A78BFA;
	color: #1C1C1E;
	font-weight: 600;
}

button.primary:hover {
	background-color: #B9A3FB;
	border-color: #B9A3FB;
}

button.primary:active {
	background-color: #9C7DF5;
}

button.solid {
	background-color: #1C1C1E;
	border-color: #1C1C1E;
}

button.solid:hover {
	background-color: #2C2C2E;
	border-color: #2C2C2E;
}

button.ghost {
	border-color: transparent;
	color: #A1A1A6;
}

button.ghost:hover {
	color: #F5F5F7;
	background-color: #FFFFFF14;
}

button.danger {
	background-color: #FF453A;
	border-color: #FF453A;
	color: #FFFFFF;
	font-weight: 600;
}

button.danger:hover {
	background-color: #FF5C52;
	border-color: #FF5C52;
}

/* Поле ввода и список: кайма в один пиксель, фокус — её цвет */

input.text,
select {
	display: block;
	height: 44dp;
	line-height: 24dp;
	padding: 9dp 14dp;
	box-sizing: border-box;
	border-radius: 12dp;
	background-color: #1C1C1E;
	border: 1dp #38383A;
	color: #F5F5F7;
	font-size: 15dp;
	transition: border-color 0.12s linear-in-out;
}

input.text:hover,
select:hover {
	border-color: #A78BFA3D;
}

input.text:focus,
select:focus {
	border-color: #A78BFA;
}

input.text {
	cursor: text;
	caret-color: #A78BFA;
}

select {
	cursor: pointer;
}

select selectvalue {
	padding-right: 24dp;
}

select selectarrow {
	width: 34dp;
	height: 42dp;
	margin: -9dp -14dp 0 -34dp;
	decorator: image(icons/chevron.png scale-none);
	image-color: #86868B;
	transform: rotate(-90deg);
}

/* Выпадающий список висит над страницей, потому тень у него есть */

select selectbox {
	margin-top: 4dp;
	padding: 4dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
	border: 1dp #38383A;
	box-shadow: 0 4dp 12dp #00000073, 0 16dp 40dp -12dp #000000A6;
}

select selectbox option {
	padding: 7dp 10dp;
	border-radius: 8dp;
	color: #A1A1A6;
	cursor: pointer;
}

select selectbox option:hover {
	background-color: #FFFFFF14;
	color: #F5F5F7;
}

select selectbox option:checked {
	background-color: #221B36;
	color: #A78BFA;
}

input.checkbox {
	width: 18dp;
	height: 18dp;
	border-radius: 5dp;
	background-color: #1C1C1E;
	border: 1dp #38383A;
	cursor: pointer;
	margin-right: 8dp;
	transition: border-color 0.12s linear-in-out, background-color 0.12s linear-in-out;
}

input.checkbox:hover {
	border-color: #A78BFA;
}

input.checkbox:checked {
	background-color: #A78BFA;
	border-color: #A78BFA;
	decorator: image(icons/check.png);
	image-color: #1C1C1E;
}

.empty {
	padding: 24dp;
	text-align: center;
	color: #86868B;
}

.error {
	margin-top: 12dp;
	font-size: 14dp;
	color: #FF453A;
}

/* Уведомление о прошлом заходе на стартовом экране */

.notice {
	display: flex;
	flex-direction: row;
	align-items: center;
	/* Ширина твёрдая: у flex-элемента с max-width RmlUi считает высоту до
	   того, как ужмёт ширину, и текст вылезает из рамки */
	width: 520dp;
	box-sizing: border-box;
	margin-bottom: 24dp;
	padding: 12dp 16dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
	border: 1dp #FF453A4D;
	color: #F5F5F7;
	font-size: 15dp;
	line-height: 1.45;
}

.notice p {
	display: block;
	flex: 1;
	width: 0;
	min-width: 0;
}

.notice button {
	height: 32dp;
	line-height: 30dp;
	padding: 0 10dp;
	margin-left: 12dp;
}

/* Подтверждение опасного действия — врезка в карточке, а не окно */

.confirm {
	display: flex;
	flex-direction: column;
	margin-top: 16dp;
	padding: 14dp 16dp;
	border-radius: 12dp;
	background-color: #1C1C1E;
	border: 1dp #FF453A4D;
}

.confirm p {
	margin-bottom: 10dp;
}

/* Кольцо ожидания — то же, что крутится в лаунчере и на сайте: двенадцать
   квадратов по кругу, по ним бежит хвост яркости. У всех одна анимация,
   i-й отстаёт на i шагов; ступени хвоста взяты из лаунчера, плавное
   затухание читалось бы вращающимся пятном. */

.ring {
	position: relative;
	display: block;
	width: 40dp;
	height: 40dp;
}

.ring i {
	position: absolute;
	display: block;
	top: 17.5dp;
	left: 17.5dp;
	width: 5dp;
	height: 5dp;
	border-radius: 1dp;
	background-color: #A78BFA;
}

.ring.big {
	width: 64dp;
	height: 64dp;
}

.ring.big i {
	top: 28dp;
	left: 28dp;
	width: 8dp;
	height: 8dp;
	border-radius: 2dp;
}

/* Хвост задан не задержкой, а своим набором кадров на каждый квадрат:
   RmlUi отрицательную задержку не понимает, а с положительной кольцо
   секунду стояло бы ровно светлым. Кадры одни и те же, сдвинутые на шаг. */

.ring i:nth-child(1) {
	transform: rotate(0deg) translateY(-15dp) rotate(0deg);
	animation: 0.96s linear infinite ring-tail-0;
}
.ring.big i:nth-child(1) {
	transform: rotate(0deg) translateY(-24dp) rotate(0deg);
}
@keyframes ring-tail-0 {
	0.00% { opacity: 1; }
	8.33% { opacity: 0.7; }
	16.67% { opacity: 0.48; }
	25.00% { opacity: 0.3; }
	33.33% { opacity: 0.18; }
	41.67% { opacity: 0.09; }
	50.00% { opacity: 0.09; }
	58.33% { opacity: 0.09; }
	66.67% { opacity: 0.09; }
	75.00% { opacity: 0.09; }
	83.33% { opacity: 0.09; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 1; }
}

.ring i:nth-child(2) {
	transform: rotate(30deg) translateY(-15dp) rotate(-30deg);
	animation: 0.96s linear infinite ring-tail-1;
}
.ring.big i:nth-child(2) {
	transform: rotate(30deg) translateY(-24dp) rotate(-30deg);
}
@keyframes ring-tail-1 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 1; }
	16.67% { opacity: 0.7; }
	25.00% { opacity: 0.48; }
	33.33% { opacity: 0.3; }
	41.67% { opacity: 0.18; }
	50.00% { opacity: 0.09; }
	58.33% { opacity: 0.09; }
	66.67% { opacity: 0.09; }
	75.00% { opacity: 0.09; }
	83.33% { opacity: 0.09; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 0.09; }
}

.ring i:nth-child(3) {
	transform: rotate(60deg) translateY(-15dp) rotate(-60deg);
	animation: 0.96s linear infinite ring-tail-2;
}
.ring.big i:nth-child(3) {
	transform: rotate(60deg) translateY(-24dp) rotate(-60deg);
}
@keyframes ring-tail-2 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 0.09; }
	16.67% { opacity: 1; }
	25.00% { opacity: 0.7; }
	33.33% { opacity: 0.48; }
	41.67% { opacity: 0.3; }
	50.00% { opacity: 0.18; }
	58.33% { opacity: 0.09; }
	66.67% { opacity: 0.09; }
	75.00% { opacity: 0.09; }
	83.33% { opacity: 0.09; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 0.09; }
}

.ring i:nth-child(4) {
	transform: rotate(90deg) translateY(-15dp) rotate(-90deg);
	animation: 0.96s linear infinite ring-tail-3;
}
.ring.big i:nth-child(4) {
	transform: rotate(90deg) translateY(-24dp) rotate(-90deg);
}
@keyframes ring-tail-3 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 0.09; }
	16.67% { opacity: 0.09; }
	25.00% { opacity: 1; }
	33.33% { opacity: 0.7; }
	41.67% { opacity: 0.48; }
	50.00% { opacity: 0.3; }
	58.33% { opacity: 0.18; }
	66.67% { opacity: 0.09; }
	75.00% { opacity: 0.09; }
	83.33% { opacity: 0.09; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 0.09; }
}

.ring i:nth-child(5) {
	transform: rotate(120deg) translateY(-15dp) rotate(-120deg);
	animation: 0.96s linear infinite ring-tail-4;
}
.ring.big i:nth-child(5) {
	transform: rotate(120deg) translateY(-24dp) rotate(-120deg);
}
@keyframes ring-tail-4 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 0.09; }
	16.67% { opacity: 0.09; }
	25.00% { opacity: 0.09; }
	33.33% { opacity: 1; }
	41.67% { opacity: 0.7; }
	50.00% { opacity: 0.48; }
	58.33% { opacity: 0.3; }
	66.67% { opacity: 0.18; }
	75.00% { opacity: 0.09; }
	83.33% { opacity: 0.09; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 0.09; }
}

.ring i:nth-child(6) {
	transform: rotate(150deg) translateY(-15dp) rotate(-150deg);
	animation: 0.96s linear infinite ring-tail-5;
}
.ring.big i:nth-child(6) {
	transform: rotate(150deg) translateY(-24dp) rotate(-150deg);
}
@keyframes ring-tail-5 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 0.09; }
	16.67% { opacity: 0.09; }
	25.00% { opacity: 0.09; }
	33.33% { opacity: 0.09; }
	41.67% { opacity: 1; }
	50.00% { opacity: 0.7; }
	58.33% { opacity: 0.48; }
	66.67% { opacity: 0.3; }
	75.00% { opacity: 0.18; }
	83.33% { opacity: 0.09; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 0.09; }
}

.ring i:nth-child(7) {
	transform: rotate(180deg) translateY(-15dp) rotate(-180deg);
	animation: 0.96s linear infinite ring-tail-6;
}
.ring.big i:nth-child(7) {
	transform: rotate(180deg) translateY(-24dp) rotate(-180deg);
}
@keyframes ring-tail-6 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 0.09; }
	16.67% { opacity: 0.09; }
	25.00% { opacity: 0.09; }
	33.33% { opacity: 0.09; }
	41.67% { opacity: 0.09; }
	50.00% { opacity: 1; }
	58.33% { opacity: 0.7; }
	66.67% { opacity: 0.48; }
	75.00% { opacity: 0.3; }
	83.33% { opacity: 0.18; }
	91.67% { opacity: 0.09; }
	100.00% { opacity: 0.09; }
}

.ring i:nth-child(8) {
	transform: rotate(210deg) translateY(-15dp) rotate(-210deg);
	animation: 0.96s linear infinite ring-tail-7;
}
.ring.big i:nth-child(8) {
	transform: rotate(210deg) translateY(-24dp) rotate(-210deg);
}
@keyframes ring-tail-7 {
	0.00% { opacity: 0.09; }
	8.33% { opacity: 0.09; }
	16.67% { opacity: 0.09; }
