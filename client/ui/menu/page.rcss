/*
 * Общее для полноэкранных страниц (настройки, одиночная и сетевая игра):
 * чёрная страница, шапка «стрелка назад и имя страницы» в одной строке, как
 * в настройках лаунчера и кабинета, карточки на странице и заголовки
 * разделов.
 */

body.page {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	justify-content: flex-start;
	background-color: #000000;
	box-sizing: border-box;
	padding: 40dp 88dp 40dp 88dp;
	font-size: 15dp;
}

.page-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 44dp;
	margin-bottom: 24dp;
}

/* Назад: значковая кнопка без рамки и заливки в покое; стрелка подаётся
   влево при наведении */

.back {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	width: 44dp;
	height: 44dp;
	margin-left: -12dp;
	margin-right: 6dp;
	border-radius: 12dp;
	cursor: pointer;
	transition: background-color 0.12s linear-in-out;
}

.back .arrow {
	width: 20dp;
	height: 20dp;
	decorator: image(icons/back.png scale-none);
	image-color: #A1A1A6;
	transition: transform 0.18s cubic-out, image-color 0.12s linear-in-out;
}

.back:hover {
	background-color: #FFFFFF14;
}

.back:hover .arrow {
	image-color: #F5F5F7;
	transform: translateX(-3dp);
}

.page-head h1 {
	flex: 1;
}

/* Клавиша в подсказке: плитка, а не рамка */

.kbd {
	display: block;
	min-width: 22dp;
	padding: 2dp 6dp;
	border-radius: 6dp;
	background-color: #2C2C2E;
	font-family: "Departure Mono";
	font-size: 11dp;
	line-height: 14dp;
	text-align: center;
	color: #86868B;
}

/* Карточка: единственная поверхность страницы; без рамки и тени — от
   страницы её отделяет собственный цвет */

.panel {
	display: flex;
	flex-direction: column;
	border-radius: 18dp;
	background-color: #1C1C1E;
}

/* Заголовок раздела в карточке: строка, отделённая швом от того, что ниже */

h3.group {
	display: block;
	font-size: 18dp;
	font-weight: 500;
	color: #F5F5F7;
	margin: 0;
	padding: 18dp 0 12dp 0;
	border-bottom: 1dp #2C2C2E;
}

/* Надпись над группой: подпись к списку, а не заголовок */

.eyebrow {
	display: block;
	font-size: 13dp;
	color: #86868B;
	margin-bottom: 8dp;
}
