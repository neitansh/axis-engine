#include <windows.h>
#include <winuser.h>
#include <commctrl.h>
#include <richedit.h>

#ifndef USE_CMAKE_CONFIG_H
#define USE_CMAKE_CONFIG_H
#endif
#include "config.h"
#undef USE_CMAKE_CONFIG_H

#ifdef __MINGW32__
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "axis.exe.manifest"
#endif

LANGUAGE 0, SUBLANG_NEUTRAL
130        ICON         "axis-icon.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

1 VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifndef NDEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0000 — language-neutral, not 0409 (English). Windows looks up the
        // block by the user's language and falls back to the first one, so an
        // English-only block makes the file look untranslated on every other
        // system. The strings here are names and a copyright line; they are
        // the same in every language.
        BLOCK "000004b0"
    BEGIN
        VALUE "CompanyName", "the iVy Studio"
        VALUE "FileDescription", PROJECT_NAME_C " engine"
        VALUE "FileVersion", VERSION_STRING
        VALUE "InternalName", PROJECT_NAME
        VALUE "OriginalFilename", PROJECT_NAME ".exe"
        VALUE "LegalCopyright", "\251 the iVy Studio"
        VALUE "ProductName", PROJECT_NAME_C
        VALUE "ProductVersion", PRODUCT_VERSION_STRING
    END
END
BLOCK "VarFileInfo"
BEGIN
    VALUE "Translation", 0x0000, 1200
END
END

