{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23
  },
  "configurePresets": [
    {
      "name": "axis-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "RUN_IN_PLACE": "TRUE",
        "CMAKE_C_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold",
        "CMAKE_JOB_POOLS": "compile=8;link=1",
        "CMAKE_JOB_POOL_COMPILE": "compile",
        "CMAKE_JOB_POOL_LINK": "link",
        "ENABLE_LEVELDB": "FALSE",
        "ENABLE_REDIS": "FALSE",
        "ENABLE_POSTGRESQL": "FALSE",
        "ENABLE_PROMETHEUS": "FALSE"
      }
    },
    {
      "name": "dev",
      "displayName": "Dev",
      "description": "Сборка для работы: ninja, кэш компилятора, mold, ограниченная память",
      "inherits": "axis-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug",
      "description": "Debug preset with debug symbols and no optimizations",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      },
      "inherits": "axis-base"
    },
    {
      "name": "Release",
      "displayName": "Release",
      "description": "Release with optimizations and in-place build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "inherits": "axis-base"
    },
    {
      "name": "Server-Release",
      "displayName": "Server Release",
      "description": "Release build for Headless Server (no GUI)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_SERVER": "TRUE",
        "BUILD_CLIENT": "FALSE"
      },
      "inherits": "axis-base"
    },
    {
      "name": "RelWithDebInfo",
      "displayName": "RelWithDebInfo",
      "description": "Release with debug symbols and in-place build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      },
      "inherits": "axis-base"
    },
    {
      "name": "MinSizeRel",
      "displayName": "MinSizeRel",
      "description": "Release with minimal code size and in-place build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      },
      "inherits": "axis-base"
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    },
    {
      "name": "Server-Release",
      "configurePreset": "Server-Release"
    },
    {
      "name": "RelWithDebInfo",
      "configurePreset": "RelWithDebInfo"
    },
    {
      "name": "MinSizeRel",
      "configurePreset": "MinSizeRel"
    }
  ]
}
